index 0000000..c527cb5
--- /dev/null
+++ b/crates/shinobi-sim/tests/shield_battery.rs
@@ -0,0 +1,230 @@
+//! Kinetic Battery counterplay and determinism (`docs/weapons/shield.md`).
+
+use std::time::Duration;
+
+use shinobi_proto::intent::{ClientPacket, PlayerIntent, ViewState};
+use shinobi_proto::quant::{q_pitch, q_yaw};
+use shinobi_sim::balance::Balance;
+use shinobi_sim::character::Cfg;
+use shinobi_sim::combat::DamageKind;
+use shinobi_sim::level::{parse_level_file, LevelBox, LevelDesc};
+use shinobi_sim::pvp::{apply_hits, Cause, PvpHit};
+use shinobi_sim::shield::BATTERY_MAX;
+use shinobi_sim::tick::Server;
+
+const A: u16 = 1;
+const B: u16 = 2;
+const ONE_TICK: Duration = Duration::from_nanos(16_666_667);
+
+fn duel() -> Server {
+    let lv = LevelDesc { boxes: vec![LevelBox::new([0.0, -0.5, 0.0], [50.0, 0.5, 50.0])], spawns: vec![[0.0, 0.81, 0.0], [0.0, 0.81, 1.5]] };
+    let mut s = Server::new(Cfg::default());
+    lv.apply_to_server(&mut s);
+    s.set_spawns(lv.spawns.clone());
+    s.set_balance(Balance::default()).unwrap();
+    s.add_player(A, [0.0, 0.81, 0.0]);
+    s.add_player(B, [0.0, 0.81, 1.5]);
+    for p in &mut s.players {
+        p.vitals.invuln_until_tick = 0;
+        p.vitals.hp = p.vitals.max_hp;
+        p.yaw = q_yaw(0.0);
+    }
+    s
+}
+
+fn hit(s: &mut Server, victim: u16, amount: f32, kind: DamageKind, guarded: bool, tick: u32) -> f32 {
+    let vi = s.players.iter().position(|p| p.id == victim).unwrap();
+    let a = s.players[vi].vitals.hp;
+    let (block, melee, cloak, shield) = (s.balance.guard.cfg(), s.balance.melee.cfg(), s.balance.combat.cloak, s.balance.shield.cfg());
+    let h = PvpHit { attacker: A, victim: vi, amount, cause: Cause::Weapon(kind), head: false, stealth: false, point: [0.0, 0.81, 0.0], guarded };
+    let mut out = Vec::new();
+    apply_hits(&mut s.players, &mut s.world, &[h], tick, 150, &block, &melee, &cloak, &shield, None, &mut out);
+    a - s.players[vi].vitals.hp
+}
+
+fn shield(s: &Server, id: u16) -> shinobi_sim::shield::ShieldState {
+    s.players.iter().find(|p| p.id == id).unwrap().shield
+}
+
+fn hold_block(s: &mut Server, id: u16, since: u32) {
+    let p = s.players.iter_mut().find(|p| p.id == id).unwrap();
+    p.blk.held = true;
+    p.blk.since = since;
+    p.blk.energy = 1.0;
+    p.yaw = q_yaw(0.0);
+}
+
+#[test]
+fn blocking_a_star_or_arrow_charges_the_battery_but_blocking_a_cut_does_not() {
+    let mut s = duel();
+    hold_block(&mut s, B, 0);
+    assert!((hit(&mut s, B, 7.0, DamageKind::Shuriken, false, 100) - 0.0).abs() < 0.01, "a star on the shield is deflected");
+    assert_eq!(shield(&s, B).battery, 80);
+
+    hold_block(&mut s, B, 0);
+    assert!((hit(&mut s, B, 20.0, DamageKind::Slash, false, 100) - 3.0).abs() < 0.01, "a cut leaks 15%");
+    assert_eq!(shield(&s, B).battery, 80, "a blocked cut never feeds the Battery");
+
+    hold_block(&mut s, B, 0);
+    assert!(hit(&mut s, B, 20.0, DamageKind::Arrow, true, 100) > 0.0, "the server already resolved the arrow block");
+    assert_eq!(shield(&s, B).battery, 160, "a blocked arrow uses the same charge as a blocked star");
+}
+
+#[test]
+fn a_parry_charges_and_still_negates_the_hit() {
+    let mut s = duel();
+    hold_block(&mut s, B, 99);
+    assert_eq!(hit(&mut s, B, 20.0, DamageKind::Slash, false, 100), 0.0);
+    assert_eq!(shield(&s, B).battery, 250);
+    hold_block(&mut s, B, 99);
+    assert_eq!(hit(&mut s, B, 7.0, DamageKind::Shuriken, false, 100), 0.0);
+    assert_eq!(shield(&s, B).battery, 500);
+}
+
+#[test]
+fn the_aura_boosts_only_unguarded_slash_damage() {
+    let mut s = duel();
+    let cfg = s.balance.shield.cfg();
+    let ai = s.players.iter().position(|p| p.id == A).unwrap();
+    s.players[ai].shield.battery = BATTERY_MAX;
+    assert_eq!(s.players[ai].shield.update(100, &cfg), shinobi_sim::shield::ShieldTick::AuraStart);
+
+    assert!((hit(&mut s, B, 20.0, DamageKind::Slash, false, 100) - 24.0).abs() < 0.01, "20 x 1.2");
+    let bi = s.players.iter().position(|p| p.id == B).unwrap();
+    s.players[bi].vitals.hp = s.players[bi].vitals.max_hp;
+    hold_block(&mut s, B, 0);
+    assert!((hit(&mut s, B, 20.0, DamageKind::Slash, false, 100) - 3.0).abs() < 0.01, "a shield is still 15%, never 18%");
+    s.players[bi].vitals.hp = s.players[bi].vitals.max_hp;
+    assert!((hit(&mut s, B, 7.0, DamageKind::Shuriken, false, 100) - 0.0).abs() < 0.01, "stars are not boosted");
+    assert!(s.players[ai].shield.aura_active(399));
+    s.players[ai].shield.update(400, &cfg);
+    assert!(!s.players[ai].shield.aura_active(400));
+    s.players[bi].vitals.hp = s.players[bi].vitals.max_hp;
+    s.players[bi].blk.held = false;
+    assert!((hit(&mut s, B, 20.0, DamageKind::Slash, false, 400) - 20.0).abs() < 0.01, "expired aura is back to base damage");
+}
+
+#[test]
+fn core_vent_fills_over_fill_ticks_then_cools_down_per_player() {
+    let text = "box 0 -0.5 0 50 0.5 50\nspawn 0 0.81 0\nspawn 10 0.81 0\n\
+        zone 0 0.81 0 2 2 2 core_vent fill_ticks=5 cooldown_ticks=10\n";
+    let f = parse_level_file(text).unwrap();
+    let mut s = Server::new(Cfg::default());
+    f.level.apply_to_server(&mut s);
+    s.set_spawns(f.level.spawns.clone());
+    s.set_level_features(f.features);
+    s.add_player(A, [0.0, 0.81, 0.0]);
+    s.add_player(B, [10.0, 0.81, 0.0]);
+    let cfg = s.balance.shield.cfg();
+    let sim_cfg = *s.cfg();
+
+    for tick in 0..4 {
+        s.level_features.end_tick(&s.world, &mut s.players, tick, &sim_cfg, true);
+        for p in &mut s.players {
+            p.shield.update(tick, &cfg);
+        }
+    }
+    assert_eq!(shield(&s, A).battery, 800);
+    assert!(!shield(&s, A).aura_active(3));
+    assert_eq!(shield(&s, B).battery, 0, "a player outside the vent gets nothing");
+
+    s.level_features.end_tick(&s.world, &mut s.players, 4, &sim_cfg, true);
+    for p in &mut s.players {
+        p.shield.update(4, &cfg);
+    }
+    assert_eq!(shield(&s, A).battery, 0, "full charge is consumed by the aura");
+    assert_eq!(shield(&s, A).aura_ticks_left(4), 300);
+    assert_eq!(shield(&s, A).vent_ready_tick, 14);
+
+    for tick in 5..14 {
+        s.level_features.end_tick(&s.world, &mut s.players, tick, &sim_cfg, true);
+    }
+    assert_eq!(shield(&s, A).vent_fill_ticks, 0, "the vent is on cooldown");
+    s.level_features.end_tick(&s.world, &mut s.players, 14, &sim_cfg, true);
+    assert_eq!(shield(&s, A).vent_fill_ticks, 1, "cooldown ended");
+}
+
+fn replay_server() -> Server {
+    let text = "box 0 -0.5 0 50 0.5 50\nspawn 0 0.81 0\nspawn 20 0.81 0\n\
+        zone 0 0.81 0 2 2 2 core_vent fill_ticks=30 cooldown_ticks=120\n";
+    let f = parse_level_file(text).unwrap();
+    let mut s = Server::new(Cfg::default());
+    f.level.apply_to_server(&mut s);
+    s.set_spawns(f.level.spawns.clone());
+    s.set_level_features(f.features);
+    let mut b = Balance::demo();
+    b.player.invuln_ticks = 12;
+    b.player.first_spawn_invuln_ticks = 0;
+    s.set_balance(b).unwrap();
+    s.match_state.cfg.warmup_ticks = 1;
+    s.match_state.cfg.min_players = 1;
+    s.match_state.cfg.time_limit_ticks = u32::MAX / 2;
+    s.match_state.cfg.frag_limit = u16::MAX;
+    s.add_player(A, [0.0, 0.81, 0.0]);
+    s.add_player(B, [20.0, 0.81, 0.0]);
+    for p in &mut s.players {
+        p.vitals.invuln_until_tick = 0;
+    }
+    s
+}
+
+#[test]
+fn thousand_tick_replay_is_identical() {
+    let mut a = replay_server();
+    let mut b = replay_server();
+    let mut saw_aura = false;
+    for _ in 0..1000 {
+        a.frame(ONE_TICK);
+        b.frame(ONE_TICK);
+        saw_aura |= a.players.iter().any(|p| p.shield.aura_active(a.tick));
+        assert_eq!(a.players.iter().map(|p| (p.id, p.shield)).collect::<Vec<_>>(), b.players.iter().map(|p| (p.id, p.shield)).collect::<Vec<_>>());
+        assert_eq!(a.players.iter().map(|p| p.pos(&a.world)).collect::<Vec<_>>(), b.players.iter().map(|p| p.pos(&b.world)).collect::<Vec<_>>());
+    }
+    assert!(saw_aura, "the replay exercised the core-vent fill and aura");
+}
+
+fn feed(s: &mut Server, id: u16, mut it: PlayerIntent) {
+    let tick = s.tick;
+    it.tick = tick;
+    let from = tick.saturating_sub(6).max(1);
+    let pkt = ClientPacket { ack_snapshot_tick: from, view: ViewState { from_tick: from, alpha: 0 }, intents: vec![it], ..Default::default() };
+    s.ingest(id, &pkt.encode().unwrap());
+}
+
+fn movement_server() -> Server {
+    let lv = LevelDesc { boxes: vec![LevelBox::new([0.0, -0.5, 0.0], [100.0, 0.5, 100.0])], spawns: vec![[0.0, 0.81, 0.0]] };
+    let mut s = Server::new(Cfg::default());
+    lv.apply_to_server(&mut s);
+    s.set_spawns(lv.spawns.clone());
+    let mut b = Balance::demo();
+    b.player.first_spawn_invuln_ticks = 0;
+    s.set_balance(b).unwrap();
+    s.match_state.cfg.warmup_ticks = 1;
+    s.match_state.cfg.min_players = 1;
+    s.match_state.cfg.time_limit_ticks = u32::MAX / 2;
+    s.add_player(A, [0.0, 0.81, 0.0]);
+    for _ in 0..120 {
+        feed(&mut s, A, PlayerIntent::default());
+        s.frame(ONE_TICK);
+    }
+    s.players[0].vitals.invuln_until_tick = 0;
+    s
+}
+
+#[test]
+fn an_active_aura_does_not_change_movement() {
+    let mut plain = movement_server();
+    let mut aura = movement_server();
+    let cfg = aura.balance.shield.cfg();
+    aura.players[0].shield.battery = BATTERY_MAX;
+    assert_eq!(aura.players[0].shield.update(aura.tick, &cfg), shinobi_sim::shield::ShieldTick::AuraStart);
+    for t in 0..120u32 {
+        let it = PlayerIntent { move_z: 127, aim_yaw: q_yaw(0.3), aim_pitch: q_pitch(0.0), ..Default::default() };
+        feed(&mut plain, A, it);
+        feed(&mut aura, A, it);
+        plain.frame(ONE_TICK);
+        aura.frame(ONE_TICK);
+        assert!(aura.players[0].shield.aura_active(aura.tick), "tick {t}: aura still on");
+        assert_eq!(plain.players[0].pos(&plain.world), aura.players[0].pos(&aura.world), "tick {t}");
+    }
+}
diff --git a/crates/shinobi-sim/tests/speed_lanes.rs b/crates/shinobi-sim/tests/speed_lanes.rs
new file mode 100644
index 0000000..920835f
--- /dev/null
+++ b/crates/shinobi-sim/tests/speed_lanes.rs
@@ -0,0 +1,282 @@
+use shinobi_sim::character::{sync_body_colliders, Cfg, CharacterSystem, MoveState, PhysicsWorld, PlayerInput};
+use shinobi_sim::level::{parse_level_file, LevelFeatures};
+use shinobi_sim::movement::step_player;
+use shinobi_sim::rapier3d::prelude::*;
+
+const DT: f32 = 1.0 / 60.0;
+const SPAWN: [f32; 3] = [10.0, 5.0, 4.7];
+
+fn scene(zone_lines: &str) -> (PhysicsWorld, CharacterSystem, LevelFeatures) {
+    let text = format!(
+        "box 0 -0.5 0 100 0.5 100\n\
+         box 0 4 5.5 200 4 0.5\n\
+         spawn 10 5 4.7\n{zone_lines}"
+    );
+    let f = parse_level_file(&text).unwrap();
+    let mut w = PhysicsWorld {
+        bodies: RigidBodySet::new(),
+        colliders: ColliderSet::new(),
+        islands: IslandManager::new(),
+        queries: QueryPipeline::new(),
+    };
+    f.level.insert_into(&mut w);
+    let cfg = Cfg::default();
+    let body = w.bodies.insert(
+        RigidBodyBuilder::kinematic_position_based()
+            .translation(vector![SPAWN[0], SPAWN[1], SPAWN[2]])
+            .build(),
+    );
+    w.colliders.insert_with_parent(
+        ColliderBuilder::capsule_y(cfg.half_height, cfg.radius).build(),
+        body,
+        &mut w.bodies,
+    );
+    let mut ch = CharacterSystem::new(body, cfg);
+    ch.vel = vector![cfg.wall_speed, 0.0, 0.0];
+    ch.state = MoveState::WallRun {
+        normal: vector![0.0, 0.0, -1.0],
+        tangent: vector![1.0, 0.0, 0.0],
+        time_left: 1000.0,
+    };
+    (w, ch, f.features)
+}
+
+fn pos(ch: &CharacterSystem, w: &PhysicsWorld) -> [f32; 3] {
+    let p = w.bodies[ch.body].translation();
+    [p.x, p.y, p.z]
+}
+
+fn step(ch: &mut CharacterSystem, w: &mut PhysicsWorld, features: &LevelFeatures, input: &PlayerInput, now: &mut f32) {
+    let p = pos(ch, w);
+    let normal = ch.wall_normal().map(|n| [n.x, n.y, n.z]);
+    ch.speed_lane = features.speed_lane_for(p, normal);
+    step_player(ch, input, w, *now, DT);
+    *now += DT;
+}
+
+fn wall_input() -> PlayerInput {
+    PlayerInput {
+        move_dir: vector![1.0, 0.0, 0.0],
+        jump_held: true,
+        wall_cling: true,
+        ..Default::default()
+    }
+}
+
+#[test]
+fn speed_lane_boosts_only_a_wall_run_and_respects_cap() {
+    let (mut w, mut ch, features) = scene(
+        "zone 50 4 4.5 50 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=5\n",
+    );
+    let input = wall_input();
+    let mut now = 0.0;
+    for _ in 0..40 {
+        step(&mut ch, &mut w, &features, &input, &mut now);
+    }
+    assert!(matches!(ch.state, MoveState::WallRun { .. }), "{:?}", ch.state);
+    let base = ch.cfg.wall_speed;
+    assert!(ch.vel.x > base * 1.10, "boosted wall run: {}", ch.vel.x);
+    assert!(ch.vel.x <= base * 1.15 + 1e-3, "authored mult cap: {}", ch.vel.x);
+
+    let (mut w, mut ch, features) = scene(
+        "zone 50 4 4.5 50 4 0.5 speed_lane cap=1.6 decay=0.9 mult=3 wall_run_m=0\n",
+    );
+    let mut now = 0.0;
+    for _ in 0..60 {
+        step(&mut ch, &mut w, &features, &input, &mut now);
+    }
+    let base = ch.cfg.wall_speed;
+    assert!(ch.vel.x <= base * 1.6 + 1e-3, "hard cap engaged: {}", ch.vel.x);
+    assert!(ch.vel.x > base * 1.5, "cap is reachable: {}", ch.vel.x);
+}
+
+#[test]
+fn speed_lane_state_does_not_boost_walking_or_airborne() {
+    let (mut w1, mut c1, f1) = scene(
+        "zone 50 4 4.5 50 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=5\n",
+    );
+    let (mut w2, mut c2, _) = scene(
+        "zone 50 4 4.5 50 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=5\n",
+    );
+    let lane = f1.speed_lane_for([10.0, 4.0, 4.5], Some([0.0, 0.0, -1.0])).unwrap();
+    let base = c1.cfg.wall_speed;
+
+    for ch in [&mut c1, &mut c2] {
+        ch.state = MoveState::Airborne;
+        ch.vel = vector![base * 1.15, 0.0, 0.0];
+    }
+    c1.speed_lane = Some(lane);
+    let mut now = 0.0;
+    for i in 0..20 {
+        step_player(&mut c1, &PlayerInput::default(), &mut w1, now, DT);
+        step_player(&mut c2, &PlayerInput::default(), &mut w2, now, DT);
+        now += DT;
+        assert_eq!(pos(&c1, &w1), pos(&c2, &w2), "airborne tick {i}");
+        assert_eq!(c1.vel, c2.vel, "airborne velocity tick {i}");
+        assert!(c1.vel.x <= base * 1.15, "lane did not add speed in the air: {}", c1.vel.x);
+    }
+
+    for (w, ch) in [(&mut w1, &mut c1), (&mut w2, &mut c2)] {
+        let body = ch.body;
+        w.bodies[body].set_position(Isometry::translation(10.0, 0.81, 4.7), true);
+        sync_body_colliders(w, body);
+        ch.state = MoveState::Grounded;
+        ch.vel = Vector::zeros();
+    }
+    c1.speed_lane = Some(lane);
+    let input = PlayerInput { move_dir: vector![1.0, 0.0, 0.0], ..Default::default() };
+    let mut now = 0.0;
+    for i in 0..40 {
+        step_player(&mut c1, &input, &mut w1, now, DT);
+        step_player(&mut c2, &input, &mut w2, now, DT);
+        now += DT;
+        assert_eq!(pos(&c1, &w1), pos(&c2, &w2), "walking tick {i}");
+        assert_eq!(c1.vel, c2.vel, "walking velocity tick {i}");
+        assert!(matches!(c1.state, MoveState::Grounded), "{:?}", c1.state);
+        assert!(c1.vel.x <= c1.cfg.run_speed + 1e-3, "walk speed unaffected: {}", c1.vel.x);
+    }
+}
+
+#[test]
+fn post_exit_band_decays_and_the_next_lane_resets_the_bonus() {
+    let (mut w, mut ch, features) = scene(
+        "zone 15 4 4.5 15 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=10\n\
+         zone 67.5 4 4.5 32.5 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=10\n",
+    );
+    let base = ch.cfg.wall_speed;
+    let input = wall_input();
+    let mut now = 0.0;
+    let mut prev_band_surplus: Option<f32> = None;
+    let mut band_ticks = 0;
+    let mut second_lane_seen = false;
+    let mut second_entry_speed = 0.0f32;
+    let mut second_full = false;
+    for _ in 0..260 {
+        let p = pos(&ch, &w);
+        let lane = features.speed_lane_for(p, ch.wall_normal().map(|n| [n.x, n.y, n.z]));
+        let in_second = lane.map_or(false, |l| l.inside) && p[0] > 35.0;
+        step(&mut ch, &mut w, &features, &input, &mut now);
+        assert!(matches!(ch.state, MoveState::WallRun { .. }), "wall run ended at x={}", p[0]);
+        let surplus = ch.vel.x - base;
+        if let Some(l) = lane {
+            if !l.inside {
+                band_ticks += 1;
+                if let Some(prev) = prev_band_surplus {
+                    assert!((surplus - prev * l.decay).abs() < 0.02, "surplus {prev} -> {surplus} at decay {}", l.decay);
+                }
+                prev_band_surplus = Some(surplus);
+            } else {
+                prev_band_surplus = None;
+            }
+        }
+        if in_second && !second_lane_seen {
+            second_lane_seen = true;
+            second_entry_speed = ch.vel.x;
+        }
+        if second_lane_seen && ch.vel.x > base * 1.10 {
+            second_full = true;
+        }
+    }
+    assert!(band_ticks > 10, "the post-exit band must be exercised: {band_ticks} ticks");
+    assert!(second_lane_seen, "the script reaches the second lane");
+    assert!(second_full, "re-entry resets the bonus: {} -> {}", second_entry_speed, ch.vel.x);
+    assert!(ch.vel.x > base * 1.10 && ch.vel.x <= base * 1.15 + 1e-3, "full boost after reset: {}", ch.vel.x);
+}
+
+fn lane_axes(z: &shinobi_sim::level::ZoneDef) -> (usize, usize) {
+    if z.half[0] > z.half[2] { (0, 2) } else { (2, 0) }
+}
+
+#[test]
+fn circuit_exposes_four_authored_speed_lanes_and_walking_does_not_match() {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../levels/ffa_circuit.lvl");
+    let f = parse_level_file(&std::fs::read_to_string(&path).unwrap()).unwrap();
+    let lanes: Vec<_> = f.features.zones.iter().filter(|z| z.tag == "speed_lane").collect();
+    assert_eq!(lanes.len(), 4, "four authored Circuit data lanes");
+    for z in &lanes {
+        assert_eq!(z.tuning["wall_run_m"], 10.0);
+        assert_eq!(z.tuning["mult"], 1.15);
+        assert_eq!(z.tuning["cap"], 1.6);
+        assert_eq!(z.tuning["decay"], 0.9);
+        let (long, thin) = lane_axes(z);
+        let dir = if z.center[thin] > 0.0 { -1.0 } else { 1.0 };
+        let mut n = [0.0f32; 3];
+        n[thin] = dir;
+        let mut p = z.center;
+        p[long] = z.center[long];
+        p[thin] -= dir * 0.2;
+        let q = f.features.speed_lane_for(p, Some(n)).expect("inside the authored lane");
+        assert!(q.inside);
+        assert!((q.multiplier() - 1.15).abs() < 1e-6, "full ramp at the lane middle");
+        assert!(f.features.speed_lane_for([p[0], 0.81, p[2]], None).is_none(), "walking has no wall face");
+    }
+
+    let mut w = PhysicsWorld {
+        bodies: RigidBodySet::new(),
+        colliders: ColliderSet::new(),
+        islands: IslandManager::new(),
+        queries: QueryPipeline::new(),
+    };
+    f.level.insert_into(&mut w);
+    let cfg = Cfg::default();
+    let body = w.bodies.insert(
+        RigidBodyBuilder::kinematic_position_based()
+            .translation(vector![27.0, 0.81, 4.5])
+            .build(),
+    );
+    w.colliders.insert_with_parent(
+        ColliderBuilder::capsule_y(cfg.half_height, cfg.radius).build(),
+        body,
+        &mut w.bodies,
+    );
+    let mut ch = CharacterSystem::new(body, cfg);
+    let input = PlayerInput { move_dir: vector![1.0, 0.0, 0.0], ..Default::default() };
+    let mut now = 0.0;
+    for _ in 0..60 {
+        let p = pos(&ch, &w);
+        assert!(f.features.speed_lane_for(p, ch.wall_normal().map(|n| [n.x, n.y, n.z])).is_none());
+        step_player(&mut ch, &input, &mut w, now, DT);
+        now += DT;
+    }
+    assert!(matches!(ch.state, MoveState::Grounded), "{:?}", ch.state);
+    assert!(ch.vel.x <= ch.cfg.run_speed + 1e-3, "normal Circuit walking is unchanged: {}", ch.vel.x);
+}
+
+#[test]
+fn naturally_entered_wall_run_picks_up_the_lane() {
+    let (mut w, mut ch, features) = scene(
+        "zone 150 4 4.5 150 4 0.5 speed_lane cap=1.6 decay=0.9 mult=1.15 wall_run_m=10\n",
+    );
+    let body = ch.body;
+    w.bodies[body].set_position(Isometry::translation(30.0, 0.81, 4.7), true);
+    sync_body_colliders(&mut w, body);
+    ch.state = MoveState::Grounded;
+    ch.vel = Vector::zeros();
+    let base = ch.cfg.wall_speed;
+    let mut now = 0.0;
+    let run = PlayerInput { move_dir: vector![1.0, 0.0, 0.0], ..Default::default() };
+    for _ in 0..30 {
+        step(&mut ch, &mut w, &features, &run, &mut now);
+    }
+    assert!(matches!(ch.state, MoveState::Grounded), "run-up: {:?}", ch.state);
+
+    step(
+        &mut ch,
+        &mut w,
+        &features,
+        &PlayerInput { jump_pressed: true, jump_held: true, wall_cling: true, move_dir: vector![1.0, 0.0, 0.0], ..Default::default() },
+        &mut now,
+    );
+    let hold = PlayerInput { jump_held: true, wall_cling: true, move_dir: vector![1.0, 0.0, 0.0], ..Default::default() };
+    let mut entered = false;
+    let mut boosted = false;
+    for _ in 0..120 {
+        step(&mut ch, &mut w, &features, &hold, &mut now);
+        if matches!(ch.state, MoveState::WallRun { .. }) {
+            entered = true;
+            boosted |= ch.vel.x > base * 1.10;
+        }
+    }
+    assert!(entered, "jump + cling did not find the wall");
+    assert!(boosted, "a naturally entered wall run did not pick up the lane: {}", ch.vel.x);
+}
diff --git a/design/CONTENT_PLAN.md b/design/CONTENT_PLAN.md
