+    }
+
+    let mut per_quadrant: BTreeMap<(i32, i32), usize> = BTreeMap::new();
+    for m in &f.movers {
+        let (lo, hi) = mover_swept(m);
+        let sx = ((lo[0] + hi[0]) * 0.5).signum() as i32;
+        let sz = ((lo[2] + hi[2]) * 0.5).signum() as i32;
+        *per_quadrant.entry((sx, sz)).or_default() += 1;
+    }
+    assert_eq!(per_quadrant.len(), 4, "one pair on each nexus diagonal");
+    assert!(per_quadrant.values().all(|&n| n == 2));
+    assert_eq!(f.movers.iter().filter(|m| m.axis == MoveAxis::X).count(), 4);
+    assert_eq!(f.movers.iter().filter(|m| m.axis == MoveAxis::Z).count(), 4);
+    assert_eq!(f.movers.iter().filter(|m| m.tuning["phase_ticks"] == 0.0).count(), 4);
+    assert_eq!(f.movers.iter().filter(|m| m.tuning["phase_ticks"] == 90.0).count(), 4);
+
+    for pair in f.movers.chunks(2) {
+        let (a, b) = (&pair[0], &pair[1]);
+        assert_eq!(a.axis, b.axis, "a pair shares its stroke axis");
+        let (pa, pb) = (a.pos_at(0), b.pos_at(0));
+        let ai = a.axis.index();
+        let ti = if ai == 0 { 2 } else { 0 };
+        assert!(
+            ((pa[ai] - pb[ai]).abs() - 6.0).abs() < 1e-4,
+            "a pair starts at opposite ends of the stroke"
+        );
+        assert!(
+            ((pa[ti] - pb[ti]).abs() - 3.0).abs() < 1e-4,
+            "a pair sits on two parallel tracks"
+        );
+    }
+    for i in 0..f.movers.len() {
+        for j in i + 1..f.movers.len() {
+            assert!(
+                !aabbs_overlap(mover_swept(&f.movers[i]), mover_swept(&f.movers[j])),
+                "pistons {i} and {j} can collide"
+            );
+        }
+    }
+
+    let lanes: Vec<&ZoneDef> = f.zones.iter().filter(|z| z.tag == "speed_lane").collect();
+    assert_eq!(lanes.len(), 4, "one speed lane per cardinal data lane");
+    for z in &lanes {
+        assert_eq!(z.center[1], 4.0);
+        assert_eq!(z.half[1], 4.0);
+        assert_eq!(z.half[0].min(z.half[2]), 0.5, "a lane zone hugs the wall, not the floor");
+        assert_eq!(z.half[0].max(z.half[2]), 14.0, "a lane zone spans the 28 m wall-run face");
+        assert!((z.center[0].abs().max(z.center[2].abs()) - 27.0).abs() < 1e-4);
+        assert!((z.center[0].abs().min(z.center[2].abs()) - 4.5).abs() < 1e-4);
+        assert_eq!(z.tuning.len(), 4);
+        assert_eq!(z.tuning["wall_run_m"], 10.0);
+        assert_eq!(z.tuning["mult"], 1.15);
+        assert_eq!(z.tuning["cap"], 1.6);
+        assert_eq!(z.tuning["decay"], 0.9);
+    }
+
+    let core: Vec<&ZoneDef> = f.zones.iter().filter(|z| z.tag == "core_vent").collect();
+    assert_eq!(core.len(), 1, "one core-vent trigger");
+    let vent = core[0];
+    assert_eq!(vent.center, [0.0, -3.5, 0.0]);
+    assert_eq!(vent.half, [4.0, 2.5, 4.0], "8 m diameter, y -6..-1");
+    assert_eq!(vent.tuning.len(), 3);
+    assert_eq!(vent.tuning["fill_ticks"], 90.0);
+    assert_eq!(vent.tuning["cooldown_ticks"], 1200.0);
+    assert_eq!(vent.tuning["reveal_ticks"], 300.0);
+
+    for z in &f.zones {
+        let (lo, hi) = zone_aabb(z);
+        for s in &l.level.spawns {
+            assert!(!in_aabb(lo, hi, *s, 1.0), "zone {} reaches spawn {s:?}", z.tag);
+        }
+        for p in &l.pickups {
+            assert!(!in_aabb(lo, hi, p.pos, 1.0), "zone {} reaches pickup {:?}", z.tag, p.pos);
+        }
+    }
+}
+
+#[test]
+fn thirty_seconds_with_live_features_is_clean() {
+    const TICKS: u32 = 30 * 60;
+    let l = load();
+    let mut s = Server::new(Cfg::default());
+    l.level.apply_to_server(&mut s);
+    s.set_level_features(l.features.clone());
+    s.set_spawns(l.level.spawns.clone());
+    for i in 0..3u16 {
+        s.add_player(i + 1, l.level.spawns[i as usize]);
+    }
+    for t in 0..TICKS {
+        let tick = s.tick;
+        assert_eq!(tick, t);
+        for id in 1..=3u16 {
+            let p = s.players.iter().find(|p| p.id == id).unwrap();
+            let pos = p.pos(&s.world);
+            let want = (-pos[0]).atan2(-pos[2]);
+            let step = angle_diff(want, dq_yaw(p.yaw)).clamp(-0.21, 0.21);
+            let pkt = ClientPacket {
+                ack_snapshot_tick: tick.saturating_sub(6).max(1),
+                view: ViewState { from_tick: tick.saturating_sub(6).max(1), alpha: 0 },
+                intents: vec![PlayerIntent {
+                    tick,
+                    move_z: 127,
+                    aim_yaw: q_yaw(dq_yaw(p.yaw) + step),
+                    aim_pitch: PITCH_LEVEL,
+                    ..Default::default()
+                }],
+                ..Default::default()
+            };
+            s.ingest(id, &pkt.encode().unwrap());
+        }
+        s.frame(Duration::from_nanos(16_666_667));
+        for p in &s.players {
+            let pos = p.pos(&s.world);
+            assert!(
+                pos.iter().all(|c| c.is_finite()) && pos[0].abs() < 55.0 && pos[2].abs() < 55.0,
+                "tick {t}: player {} at {pos:?}",
+                p.id
+            );
+            assert_eq!(p.guard.strikes, 0, "tick {t}: player {} collected a strike", p.id);
+        }
+    }
+    assert_eq!(s.tick, TICKS);
+    assert_eq!(s.players.len(), 3, "nobody was kicked");
+    for m in &l.features.movers {
+        assert_eq!(m.pos_at(TICKS), m.pos_at(0), "a 30 s run is a whole number of 3 s cycles");
+    }
+}
+
+#[test]
+fn engine_numeric_limits_cover_the_map() {
+    let l = load();
+    let far = l
+        .level
+        .boxes
+        .iter()
+        .map(|b| b.center[0].abs() + b.half[0])
+        .chain(l.level.boxes.iter().map(|b| b.center[2].abs() + b.half[2]))
+        .fold(0.0f32, f32::max);
+    let top = l
+        .level
+        .boxes
+        .iter()
+        .map(|b| b.center[1] + b.half[1])
+        .fold(0.0f32, f32::max);
+    assert!(far <= HALF + 0.01, "geometry reaches {far} m");
+    assert!(top <= 20.0, "tallest geometry {top} m");
+    let q = shinobi_proto::quant::q_pos3([2.0 * far, top, 2.0 * far]);
+    let back = shinobi_proto::quant::dq_pos3(q);
+    assert!(
+        (back[0] - 2.0 * far).abs() < 0.01 && (back[1] - top).abs() < 0.01,
+        "q_pos3 loses precision"
+    );
+    let _ = d2;
+}
