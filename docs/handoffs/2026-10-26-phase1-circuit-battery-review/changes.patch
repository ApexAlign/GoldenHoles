+        assert!(m.solid, "a piston face must be a server collider");
+        assert_eq!(m.period_ticks, 90, "90 ticks per leg = 3 s full cycle");
+        assert_eq!(m.distance, 6.0);
+        assert_eq!(m.center[1], 2.0);
+        assert_eq!(m.half[1], 2.0, "a hammer face is 4 m tall");
+        let half = match m.axis {
+            MoveAxis::X => [0.5, 2.0, 1.0],
+            MoveAxis::Z => [1.0, 2.0, 0.5],
+            MoveAxis::Y => panic!("pistons stay on the ground plane"),
