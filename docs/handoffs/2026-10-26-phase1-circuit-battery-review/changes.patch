+#[test]
+fn the_four_pit_ramps_join_the_lower_pit_to_the_ground_ring() {
+    let l = load();
+    assert!(
+        l.level
+            .boxes
+            .iter()
+            .any(|b| surface_at(b, 6.0, 0.0).map_or(false, |h| (h - PIT_FLOOR).abs() < 0.01)),
+        "no lower pit floor"
+    );
+    let ramps: Vec<&LevelBox> = l.level.boxes.iter().filter(|b| b.rot_z != 0.0).collect();
+    assert_eq!(ramps.len(), 4, "four pit ramps");
+    for b in &ramps {
+        assert!(
+            b.rot_z.abs() <= 30f32.to_radians() + 1e-3,
+            "ramp {b:?} is steeper than 30 degrees"
+        );
+        let mut samples = Vec::new();
+        let mut x = -8.0;
+        while x <= 8.0 {
+            if let Some(h) = surface_at(b, x, b.center[2]) {
+                samples.push((x, h));
+            }
+            x += 0.25;
+        }
+        assert!(
+            samples.len() > 20,
+            "ramp {b:?} has too little walkable surface"
+        );
+        let (x0, h0) = samples[0];
+        let (x1, h1) = *samples.last().unwrap();
+        assert!(
+            (h0 - PIT_FLOOR).abs() < 0.15 || (h1 - PIT_FLOOR).abs() < 0.15,
+            "ramp {b:?} does not start at the pit floor"
+        );
+        assert!(
+            h0.abs() < 0.15 || h1.abs() < 0.15,
+            "ramp {b:?} does not reach the ground ring"
+        );
+        let slope = (h1 - h0) / (x1 - x0);
+        for w in samples.windows(2) {
+            let s = (w[1].1 - w[0].1) / (w[1].0 - w[0].0);
+            assert!((s - slope).abs() < 1e-3, "ramp {b:?} is not straight");
+            assert!(s.abs() <= 0.6, "ramp {b:?} climbs too steeply");
+        }
+    }
+
+    // A 1 m surface flood from the pit floor reaches both the east and south ground ring (the ramps are the only way up).
+    let cells = low_surfaces(&l);
+    let node = |x: f32, z: f32, y: f32| {
+        (
+            x.floor() as i32,
+            z.floor() as i32,
+            (y * 100.0).round() as i32,
+        )
+    };
+    let start = node(6.5, 0.5, PIT_FLOOR);
+    assert!(
+        cells.contains_key(&(start.0, start.1)),
+        "pit floor start cell is not walkable"
+    );
+    let mut seen = HashSet::from([start]);
+    let mut q = VecDeque::from([start]);
+    while let Some((x, z, hy)) = q.pop_front() {
+        let y = hy as f32 / 100.0;
+        for (dx, dz) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
+            for &ny in cells.get(&(x + dx, z + dz)).into_iter().flatten() {
+                if (ny - y).abs() <= 0.55 {
+                    let n = (x + dx, z + dz, (ny * 100.0).round() as i32);
+                    if seen.insert(n) {
+                        q.push_back(n);
+                    }
+                }
+            }
+        }
+    }
+    assert!(
+        seen.contains(&node(12.5, 0.5, 0.0)),
+        "the east ground ring cannot be reached from the pit"
+    );
+    assert!(
+        seen.contains(&node(0.5, 12.5, 0.0)),
+        "the south ground ring cannot be reached from the pit"
+    );
+}
+
+/// Low-level walkable surfaces (pit floor, ramps and the ground deck) on a 1 m grid, with 1.8 m of headroom.
+fn low_surfaces(l: &LevelFile) -> std::collections::HashMap<(i32, i32), Vec<f32>> {
+    let mut out = std::collections::HashMap::new();
+    for x in -15i32..15 {
+        for z in -15i32..15 {
+            let (px, pz) = (x as f32 + 0.5, z as f32 + 0.5);
+            let mut hs: Vec<f32> = Vec::new();
+            for b in &l.level.boxes {
+                if let Some(h) = surface_at(b, px, pz) {
+                    if !(-6.2..=1.0).contains(&h) {
+                        continue;
+                    }
+                    let blocked = l
+                        .level
+                        .boxes
+                        .iter()
+                        .any(|o| inside(o, [px, h + 0.9, pz]) || inside(o, [px, h + 1.8, pz]));
+                    if !blocked && !hs.iter().any(|g| (g - h).abs() < 0.05) {
+                        hs.push(h);
+                    }
+                }
+            }
+            if !hs.is_empty() {
+                out.insert((x, z), hs);
+            }
+        }
+    }
+    out
+}
