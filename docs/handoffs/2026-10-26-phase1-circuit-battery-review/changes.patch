+#[test]
+fn spawns_are_supported_clear_and_each_has_two_ring_exits() {
+    let l = load();
+    let cfg = Cfg::default();
+    let reach = cfg.half_height + cfg.radius;
+    for s in &l.level.spawns {
+        assert!(
+            (s[1] - 0.81).abs() < 0.01,
+            "spawn {s:?} is not a deck spawn"
+        );
+        let radial = s[0].abs().max(s[2].abs());
+        assert!(
+            (44.0..=47.0).contains(&radial),
+            "spawn {s:?} is not on the outer ring"
+        );
+        for dy in [-reach + 0.05, -0.3, 0.0, 0.3, reach - 0.05] {
+            for (ox, oz) in [
+                (0.0, 0.0),
+                (cfg.radius, 0.0),
+                (-cfg.radius, 0.0),
+                (0.0, cfg.radius),
+                (0.0, -cfg.radius),
+            ] {
+                let p = [s[0] + ox, s[1] + dy, s[2] + oz];
+                assert!(
+                    !solid(&l, p),
+                    "spawn {s:?}: capsule point {p:?} is inside geometry"
+                );
+            }
+        }
+        let support = l.level.boxes.iter().find(|b| {
+            surface_at(b, s[0], s[2]).map_or(false, |h| (h - (s[1] - reach)).abs() < 0.1)
+        });
+        let support = support.unwrap_or_else(|| panic!("spawn {s:?} floats"));
+        assert_eq!(support.hp, 0.0, "spawn {s:?} stands on a breaking box");
+        for b in &l.level.boxes {
+            if std::ptr::eq(b, support) {
+                continue;
+            }
+            let spans_body =
+                b.center[1] + b.half[1] > s[1] - reach && b.center[1] - b.half[1] < s[1] + 2.0;
+            if spans_body {
+                assert!(
+                    box_dist_xz(b, *s) >= 3.4,
+                    "spawn {s:?} is only {:.2} m from {b:?}",
+                    box_dist_xz(b, *s)
+                );
+            }
+        }
+    }
+    let n = l.level.spawns.len();
+    let nearest: Vec<f32> = (0..n)
+        .map(|i| {
+            (0..n)
+                .filter(|j| *j != i)
+                .map(|j| d2(l.level.spawns[i], l.level.spawns[j]))
+                .fold(f32::MAX, f32::min)
+        })
+        .collect();
+    let min = nearest.iter().copied().fold(f32::MAX, f32::min);
+    let max = nearest.iter().copied().fold(0.0f32, f32::max);
+    assert!(min >= 15.0, "two spawns only {min:.1} m apart");
+    assert!(
+        max <= 36.0,
+        "a spawn is {max:.1} m from its nearest neighbour"
+    );
+
+    assert!(
+        ring_has_two_exits(&l),
+        "a spawn cannot reach two lane exits around the outer ring"
+    );
+}
+
+/// Flood the 7 m outer-ring corridor on a 1 m grid (body and head clear, deck underfoot). The loop must be one component
+/// and every spawn must touch it; at least two of the four lane-mouth gaps must border the component.
+fn ring_has_two_exits(l: &LevelFile) -> bool {
+    let n = 100i32;
+    let coord = |i: i32| -49.5 + i as f32;
+    let in_band = |p: [f32; 3]| {
+        let r = p[0].abs().max(p[2].abs());
+        (42.5..=48.5).contains(&r)
+    };
+    let walkable = |p: [f32; 3]| {
+        !solid(l, [p[0], 1.0, p[2]])
+            && !solid(l, [p[0], 2.6, p[2]])
+            && top_at(l, p[0], p[2]).map_or(false, |h| h.abs() < 0.05)
+    };
+    let mut cells: HashSet<(i32, i32)> = HashSet::new();
+    for iz in 0..n {
+        for ix in 0..n {
+            let p = [coord(ix), 0.81, coord(iz)];
+            if in_band(p) && walkable(p) {
+                cells.insert((ix, iz));
+            }
+        }
+    }
+    let cell_of = |p: [f32; 3]| {
+        (
+            ((p[0] + 49.5) / 1.0).round() as i32,
+            ((p[2] + 49.5) / 1.0).round() as i32,
+        )
+    };
+    let start = cell_of(l.level.spawns[0]);
+    assert!(
+        cells.contains(&start),
+        "the first spawn is not on the ring grid"
+    );
+    let mut seen = HashSet::from([start]);
+    let mut q = VecDeque::from([start]);
+    while let Some((x, z)) = q.pop_front() {
+        for (dx, dz) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
+            let c = (x + dx, z + dz);
+            if cells.contains(&c) && seen.insert(c) {
+                q.push_back(c);
+            }
+        }
+    }
+    assert_eq!(
+        seen.len(),
+        cells.len(),
+        "the outer ring is not one walkable loop"
+    );
+    for s in &l.level.spawns {
+        assert!(
+            seen.contains(&cell_of(*s)),
+            "spawn {s:?} is not on the reachable ring"
+        );
+    }
+    // One cell just outside each 10 m lane gap. All four border the single ring component; any spawn can use two ways round.
+    let mouths = [
+        cell_of([42.5, 0.81, 0.5]),
+        cell_of([-42.5, 0.81, 0.5]),
+        cell_of([0.5, 0.81, 42.5]),
+        cell_of([0.5, 0.81, -42.5]),
+    ];
+    mouths.iter().all(|m| seen.contains(m))
