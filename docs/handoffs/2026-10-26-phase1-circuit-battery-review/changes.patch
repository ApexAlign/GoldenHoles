+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum MoveAxis {
+    X,
+    Y,
+    Z,
+}
+
+impl MoveAxis {
+    pub fn index(self) -> usize {
+        match self {
+            MoveAxis::X => 0,
+            MoveAxis::Y => 1,
+            MoveAxis::Z => 2,
+        }
+    }
+
+    pub fn token(self) -> &'static str {
+        match self {
+            MoveAxis::X => "x",
+            MoveAxis::Y => "y",
+            MoveAxis::Z => "z",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Self> {
+        match s {
+            "x" | "X" => Some(MoveAxis::X),
+            "y" | "Y" => Some(MoveAxis::Y),
+            "z" | "Z" => Some(MoveAxis::Z),
+            _ => None,
+        }
+    }
+}
