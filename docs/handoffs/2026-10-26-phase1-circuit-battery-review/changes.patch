+#[test]
+fn counts_budget_bricks_and_destructible_gameplay_share() {
+    let l = load();
+    let text = level_text();
+    let sections = structural_sections(&text);
+    assert_eq!(
+        sections.len(),
+        l.level.boxes.len(),
+        "every box line has a section header"
+    );
+
+    assert!(
+        (60..=1800).contains(&l.level.boxes.len()),
+        "{} boxes (budget 1800)",
+        l.level.boxes.len()
+    );
+    assert_eq!(l.level.spawns.len(), 10, "ten outer-ring spawns");
+    assert_eq!(l.pickups.len(), 6, "six data cubes");
+    assert!(
+        l.pickups.iter().all(|p| p.kind == PowerKind::None),
+        "no weapon pedestals"
+    );
+    assert_eq!(
+        l.pickups.iter().filter(|p| p.respawn_secs == 25.0).count(),
+        4,
+        "four lane-mouth cubes at 25 s"
+    );
+    assert_eq!(
+        l.pickups.iter().filter(|p| p.respawn_secs == 30.0).count(),
+        2,
+        "two upper-ring cubes at 30 s"
+    );
+    assert_eq!(l.level.floor_half(), Some(HALF), "one 100 x 100 m deck");
+
+    let (mut total, mut destructible) = (0.0f32, 0.0f32);
+    let (mut gameplay_boxes, mut gameplay_destructible) = (0usize, 0usize);
+    for (b, structural) in l.level.boxes.iter().zip(&sections) {
+        let vol = 8.0 * b.half[0] * b.half[1] * b.half[2];
+        if *structural {
+            assert_eq!(b.hp, 0.0, "structural box must be permanent: {b:?}");
+            continue;
+        }
+        gameplay_boxes += 1;
+        let min_side = 2.0 * b.half[0].min(b.half[1]).min(b.half[2]);
+        let max_side = 2.0 * b.half[0].max(b.half[1]).max(b.half[2]);
+        assert!(
+            min_side >= 1.99,
+            "gameplay brick {b:?} is only {min_side:.2} m on its short side"
+        );
+        assert!(
+            max_side <= 6.01,
+            "gameplay brick {b:?} is {max_side:.2} m long"
+        );
+        total += vol;
+        if b.hp > 0.0 {
+            gameplay_destructible += 1;
+            destructible += vol;
+        }
+    }
+    assert!(gameplay_boxes >= 24, "only {gameplay_boxes} gameplay boxes");
+    assert!(
+        gameplay_destructible >= 16,
+        "only {gameplay_destructible} destructible data-rack bricks"
+    );
+    assert!(
+        destructible / total >= 0.70,
+        "only {:.0}% of gameplay volume is destructible",
+        100.0 * destructible / total
+    );
+
+    let unwalkable = unwalkable_obstacles(&l.level, Cfg::default().step_height);
+    assert!(
+        unwalkable.is_empty(),
+        "jump-only lips at {unwalkable:?}: {:?}",
+        unwalkable
+            .iter()
+            .map(|i| l.level.boxes[*i])
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        world(&l).colliders.len(),
+        l.level.boxes.len(),
+        "every box becomes one collider"
+    );
+}
