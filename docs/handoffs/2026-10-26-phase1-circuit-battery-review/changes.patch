+            let near = lo[i].abs().min(hi[i].abs());
+            let far = lo[i].abs().max(hi[i].abs());
+            assert!(
+                near >= 7.0 && far <= 15.0,
+                "piston {m:?} leaves its reserved diagonal column"
+            );
+        }
+        assert!(lo[1] >= -0.01 && hi[1] <= 8.0, "piston {m:?} leaves y 0..8");
+        for s in &l.level.spawns {
+            assert!(!in_aabb(lo, hi, *s, 1.0), "piston {m:?} reaches spawn {s:?}");
+        }
+        for p in &l.pickups {
+            assert!(!in_aabb(lo, hi, p.pos, 1.0), "piston {m:?} reaches pickup {:?}", p.pos);
+        }
+        for p in &routes {
+            assert!(!in_aabb(lo, hi, *p, 0.0), "piston {m:?} blocks a main route at {p:?}");
+        }
+        for b in &l.level.boxes {
+            if b.rot_z != 0.0 {
+                continue;
+            }
+            let blo = [b.center[0] - b.half[0], b.center[1] - b.half[1], b.center[2] - b.half[2]];
+            let bhi = [b.center[0] + b.half[0], b.center[1] + b.half[1], b.center[2] + b.half[2]];
+            assert!(
+                !aabbs_overlap((lo, hi), (blo, bhi)),
+                "piston {m:?} is embedded in permanent box {b:?}"
+            );
