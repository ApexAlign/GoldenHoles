+#[test]
+fn upper_ring_has_four_2_m_gap_segments_and_static_access() {
+    let l = load();
+    let ring: Vec<&LevelBox> = l
+        .level
+        .boxes
+        .iter()
+        .filter(|b| is_ring_segment(b))
+        .collect();
+    assert_eq!(ring.len(), 4, "four upper-ring segments");
+    for b in &ring {
+        assert_eq!(b.hp, 0.0, "upper ring is permanent");
+        assert!(
+            (b.half[0].min(b.half[2]) - 1.5).abs() < 0.01,
+            "upper-ring segment {b:?} is not 3 m wide"
+        );
+    }
+    // The four segments sit on the sides of a 20 x 20 m square. Adjacent ends are 1 m apart on each axis, i.e. a 2 m
+    // walkable gap round the corner (there is no deck in the corner notches).
+    let side = |b: &LevelBox| {
+        if (b.center[2] + 8.5).abs() < 0.01 {
+            0
+        } else if (b.center[0] - 8.5).abs() < 0.01 {
+            1
+        } else if (b.center[2] - 8.5).abs() < 0.01 {
+            2
+        } else {
+            3
+        }
+    };
+    let mut by_side = [None; 4];
+    for b in &ring {
+        by_side[side(b)] = Some(*b);
+    }
+    let x0 = |b: &LevelBox| b.center[0] - b.half[0];
+    let x1 = |b: &LevelBox| b.center[0] + b.half[0];
+    let z0 = |b: &LevelBox| b.center[2] - b.half[2];
+    let z1 = |b: &LevelBox| b.center[2] + b.half[2];
+    for a in 0..4 {
+        let p = by_side[a].unwrap();
+        let q = by_side[(a + 1) % 4].unwrap();
+        let gap_x = (x0(&p) - x1(&q)).max(x0(&q) - x1(&p)).max(0.0);
+        let gap_z = (z0(&p) - z1(&q)).max(z0(&q) - z1(&p)).max(0.0);
+        assert!(
+            (gap_x + gap_z - 2.0).abs() < 0.01,
+            "upper-ring gap between {p:?} and {q:?} is {:.2} m",
+            gap_x + gap_z
+        );
+    }
+    // braces tie every segment to the fan column
+    let braces = l
+        .level
+        .boxes
+        .iter()
+        .filter(|b| {
+            (b.center[1] + b.half[1] - UPPER).abs() < 0.01
+                && (b.half[1] - 0.3).abs() < 0.01
+                && b.half[0].max(b.half[2]) < 3.0
+        })
+        .count();
+    assert_eq!(braces, 4, "four fan braces");
+
+    // Static access: every segment is a clear grapple target from the ground ring / lane floor.
+    let w = world(&l);
+    let mut ground = Vec::new();
+    for x in -14i32..14 {
+        for z in -14i32..14 {
+            let p = [x as f32 + 0.5, 1.4, z as f32 + 0.5];
+            if !solid(&l, p) && top_at(&l, p[0], p[2]).map_or(false, |h| h.abs() < 0.05) {
+                ground.push(p);
+            }
+        }
+    }
+    for b in &ring {
+        let targets = [
+            [b.center[0], b.center[1] - b.half[1] + 0.05, b.center[2]],
+            [
+                b.center[0] + b.half[0] * 0.8,
+                b.center[1] - b.half[1] + 0.05,
+                b.center[2],
+            ],
+            [
+                b.center[0] - b.half[0] * 0.8,
+                b.center[1] - b.half[1] + 0.05,
+                b.center[2],
+            ],
+            [
+                b.center[0],
+                b.center[1] - b.half[1] + 0.05,
+                b.center[2] + b.half[2] * 0.8,
+            ],
+            [
+                b.center[0],
+                b.center[1] - b.half[1] + 0.05,
+                b.center[2] - b.half[2] * 0.8,
+            ],
+        ];
+        let mut reachable = false;
+        'search: for from in &ground {
+            for to in targets {
+                if let Some(t) = first_hit(&w, *from, to) {
+                    let len = d3(*from, to);
+                    if t >= len - 0.2 {
+                        let hit = [
+                            from[0] + (to[0] - from[0]) * t / len,
+                            from[1] + (to[1] - from[1]) * t / len,
+                            from[2] + (to[2] - from[2]) * t / len,
+                        ];
+                        if near_box(b, hit, 0.5) {
+                            reachable = true;
+                            break 'search;
+                        }
+                    }
+                }
+            }
+        }
+        assert!(
+            reachable,
+            "upper-ring segment {b:?} has no clear grapple line from the ground"
+        );
+    }
+
+    // Wall-run + jump access too: every lane wall top is within a jump of a ring segment (3 m horizontal, 1 m up).
+    let hop = Cfg::default().max_hop_rise(0.3);
+    for b in l.level.boxes.iter().filter(|b| is_lane_wall(b)) {
+        let near = ring.iter().any(|r| {
+            let dx = ((b.center[0] - b.half[0]) - (r.center[0] + r.half[0]))
+                .max((r.center[0] - r.half[0]) - (b.center[0] + b.half[0]))
+                .max(0.0);
+            let dz = ((b.center[2] - b.half[2]) - (r.center[2] + r.half[2]))
+                .max((r.center[2] - r.half[2]) - (b.center[2] + b.half[2]))
+                .max(0.0);
+            (dx * dx + dz * dz).sqrt() <= 4.0 && UPPER - WALL_TOP <= hop
+        });
+        assert!(
+            near,
+            "lane wall {b:?} has no wall-run + jump route to the upper ring"
+        );
+    }
+}
