+#[test]
+fn footprint_is_100_by_100_with_a_sealed_perimeter_and_void_beyond() {
+    let l = load();
+    let far = l
+        .level
+        .boxes
+        .iter()
+        .map(|b| b.center[0].abs() + b.half[0])
+        .chain(l.level.boxes.iter().map(|b| b.center[2].abs() + b.half[2]))
+        .fold(0.0f32, f32::max);
+    assert!(far <= HALF + 0.01, "geometry reaches {far} m sideways");
+    let top = l
+        .level
+        .boxes
+        .iter()
+        .map(|b| b.center[1] + b.half[1])
+        .fold(0.0f32, f32::max);
+    assert!(top <= 30.0, "tallest geometry is {top} m");
+
+    // Deck at y = 0 everywhere outside the 16 x 16 m pit hole, and the pit floor six metres below it.
+    let mut x: f32 = -49.0;
+    while x <= 49.0 {
+        let mut z: f32 = -49.0;
+        while z <= 49.0 {
+            if x.abs() < PIT - 0.25 && z.abs() < PIT - 0.25 {
+                let fan = x.abs() < 1.5 && z.abs() < 1.5;
+                assert!(
+                    fan || !solid(&l, [x, -0.25, z]),
+                    "deck fills the pit at ({x}, {z})"
+                );
+            } else {
+                assert!(solid(&l, [x, -0.25, z]), "deck gap at ({x}, {z})");
+            }
+            if x.abs() < PIT - 0.25 && z.abs() < PIT - 0.25 {
+                assert!(
+                    solid(&l, [x, PIT_FLOOR - 0.25, z]),
+                    "pit floor gap at ({x}, {z})"
+                );
+            }
+            z += 2.0;
+        }
+        x += 2.0;
+    }
+
+    // Four perimeter walls block every body-height crossing; nothing stands outside them.
+    for t in (-49..=49).step_by(1) {
+        let p = t as f32 + 0.5;
+        assert!(
+            solid(&l, [HALF - 0.5, 1.0, p]) && solid(&l, [-HALF + 0.5, 1.0, p]),
+            "east/west perimeter gap at z {p}"
+        );
+        assert!(
+            solid(&l, [p, 1.0, HALF - 0.5]) && solid(&l, [p, 1.0, -HALF + 0.5]),
+            "north/south perimeter gap at x {p}"
+        );
+    }
+    for p in [
+        [HALF + 1.0, 0.5, 0.0],
+        [-HALF - 1.0, 0.5, 0.0],
+        [0.0, 0.5, HALF + 1.0],
+        [0.0, 0.5, -HALF - 1.0],
+    ] {
+        assert!(!solid(&l, p), "geometry outside the perimeter at {p:?}");
+    }
+}
