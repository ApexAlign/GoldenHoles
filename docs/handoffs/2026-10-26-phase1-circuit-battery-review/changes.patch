@@ -0,0 +1,366 @@
+//! Client-side visualisation of `LevelFeatures` (`zone`, `mover`, `hazard` level directives): one unlit,
+//! translucent cuboid per feature, drawn from the level file only. Nothing here touches simulation, protocol
+//! or prediction, and the render path is geometry-only: `MoverDef::pos_at(tick)` for mover position, tick-exact
+//! hazard/zone phase for colour. Entity count is bounded by the feature count of the loaded level and nothing
+//! is allocated per frame - meshes and materials are shared and each frame only rewrites transforms and the
+//! piston charge / hazard pulse colours.
+//!
+//! Colours match `docs/ART.md` Circuit-Breaker: cyan data lanes, blue plasma core vent, hot piston charge,
+//! neutral zones, red hazard telegraph / active.
+
+use bevy::color::LinearRgba;
+use bevy::prelude::*;
+use shinobi_sim::level::{HazardDef, MoverDef, ZoneDef};
+
+use crate::net::{FeaturesRes, Net};
+
+/// One spawned feature entity, kept for the whole match.
+#[derive(Component)]
+struct FeatureEnt {
+    kind: FeatureKind,
+    /// Handle of this entity's own material so piston charge and hazard pulses can be retargeted per instance
+    /// without touching other features.
+    mat: Handle<StandardMaterial>,
+}
+
+/// Render-side copy of a level def: the update system never reads `LevelFeatures` directly.
+#[derive(Clone)]
+enum FeatureKind {
+    Mover(MoverDef),
+    Zone(ZoneDef),
+    Hazard(HazardDef),
+}
+
+pub struct FeaturesVisPlugin;
+
+impl Plugin for FeaturesVisPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(Startup, spawn_features)
+            .add_systems(Update, update_features);
+    }
+}
+
+/// Spawn one cuboid per feature. Runs once at start-up; features never change mid-match (`UdpGame::reconnect`
+/// keeps the same features, and the shell never reloads a level), so entity count stays bounded for good.
+fn spawn_features(
+    mut commands: Commands,
+    features: Res<FeaturesRes>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut mats: ResMut<Assets<StandardMaterial>>,
+) {
+    let f = &features.0;
+    if f.is_empty() {
+        return;
+    }
+    let unit = meshes.add(Cuboid::new(1.0, 1.0, 1.0));
+    for m in &f.movers {
+        let mat = mover_material(&mut mats, m);
+        commands.spawn((
+            Mesh3d(unit.clone()),
+            MeshMaterial3d(mat.clone()),
+            Transform::from_translation(Vec3::from(interp_pos_at(m, 0.0))).with_scale(Vec3::from(m.half) * 2.0),
+            FeatureEnt { kind: FeatureKind::Mover(m.clone()), mat },
+        ));
+    }
+    for z in &f.zones {
+        let mat = zone_material(&mut mats, z);
+        commands.spawn((
+            Mesh3d(unit.clone()),
+            MeshMaterial3d(mat.clone()),
+            Transform::from_translation(Vec3::from(z.center)).with_scale(Vec3::from(z.half) * 2.0),
+            FeatureEnt { kind: FeatureKind::Zone(z.clone()), mat },
+        ));
+    }
+    for h in &f.hazards {
+        let (colour, alpha, emissive) = hazard_colour_alpha(h, 0, 0.0);
+        let mat = mats.add(StandardMaterial {
+            base_color: Color::LinearRgba(LinearRgba::new(colour[0], colour[1], colour[2], alpha)),
+            emissive: LinearRgba::new(emissive[0], emissive[1], emissive[2], 1.0),
+            unlit: true,
+            alpha_mode: AlphaMode::Blend,
+            ..default()
+        });
+        commands.spawn((
+            Mesh3d(unit.clone()),
+            MeshMaterial3d(mat.clone()),
+            Transform::from_translation(Vec3::from(h.center)).with_scale(Vec3::from(h.half) * 2.0),
+            FeatureEnt { kind: FeatureKind::Hazard(h.clone()), mat },
+        ));
+    }
+}
+
+/// Mover material: pistons are forged copper that glows hot under charge; other solid movers are steel, ghost
+/// movers read as translucent so they are never mistaken for solid geometry.
+fn mover_material(mats: &mut Assets<StandardMaterial>, m: &MoverDef) -> Handle<StandardMaterial> {
+    let piston = m.tag == "piston";
+    let base = if piston { [0.55, 0.28, 0.12] } else { [0.50, 0.55, 0.60] };
+    let alpha = if m.solid { 1.0 } else { 0.45 };
+    mats.add(StandardMaterial {
+        base_color: Color::LinearRgba(LinearRgba::new(base[0], base[1], base[2], alpha)),
+        emissive: if piston {
+            LinearRgba::BLACK
+        } else {
+            LinearRgba::new(0.06, 0.07, 0.09, 1.0)
+        },
+        unlit: true,
+        alpha_mode: if alpha < 1.0 { AlphaMode::Blend } else { AlphaMode::Opaque },
+        ..default()
+    })
+}
+
+/// Zone material: translucent ambient volume. `speed_lane` cyan, `core_vent` blue plasma, everything else
+/// neutral. Flat colour stays readable without bloom (Low tier).
+fn zone_material(mats: &mut Assets<StandardMaterial>, z: &ZoneDef) -> Handle<StandardMaterial> {
+    let (colour, alpha) = zone_colour_alpha(z);
+    mats.add(StandardMaterial {
+        base_color: Color::LinearRgba(LinearRgba::new(colour[0], colour[1], colour[2], alpha)),
+        emissive: LinearRgba::new(colour[0] * 0.6, colour[1] * 0.6, colour[2] * 0.6, 1.0),
+        unlit: true,
+        alpha_mode: AlphaMode::Blend,
+        ..default()
+    })
+}
+
+pub fn zone_colour_alpha(z: &ZoneDef) -> ([f32; 3], f32) {
+    match z.tag.as_str() {
+        "speed_lane" => ([0.15, 0.80, 1.00], 0.25), // cyan data lane: traversal
+        "core_vent" => ([0.20, 0.45, 1.00], 0.35),  // blue plasma vent
+        _ => ([0.55, 0.60, 0.70], 0.12),            // neutral: never competes with gameplay cues
+    }
+}
+
+/// Rewrite every feature each rendered frame: mover position with sub-tick interpolation, piston charge
+/// colour, zone breath and hazard telegraph/active pulse. No allocations.
+fn update_features(
+    net: Res<Net>,
+    fixed: Res<Time<Fixed>>,
+    time: Res<Time>,
+    mut mats: ResMut<Assets<StandardMaterial>>,
+    mut query: Query<(&mut Transform, &FeatureEnt)>,
+) {
+    // fractional render tick: mover motion is exact at integer ticks and linear between them (each ping-pong
+    // leg is linear in the sim's fixed-point math, so this matches server motion inside a leg).
+    let tick_f = net.0.local_tick() + fixed.overstep_fraction() as f64;
+    let tick = tick_f.floor().max(0.0) as u32;
+    let t = time.elapsed_secs();
+    for (mut tf, ent) in query.iter_mut() {
+        match &ent.kind {
+            FeatureKind::Mover(m) => {
+                tf.translation = Vec3::from(interp_pos_at(m, tick_f));
+                if m.tag == "piston" {
+                    let c = piston_charge(m, tick_f);
+                    if let Some(mut mat) = mats.get_mut(&ent.mat) {
+                        // charge ramps over the first half of the cycle and peaks at full extension (the slam):
+                        // for a 180-tick (3 s) piston that is a visible 90-tick wind-up.
+                        let hot = c * c;
+                        mat.emissive = LinearRgba::new(1.0 * hot, 0.9 * hot, 0.3 * hot, 1.0);
+                    }
+                }
+            }
+            FeatureKind::Zone(z) => {
+                let (colour, alpha) = zone_colour_alpha(z);
+                // gentle plasma breath so the vent looks alive even on flat Low tier
+                let breath = 1.0 + 0.12 * (t * 2.5).sin();
+                if let Some(mut mat) = mats.get_mut(&ent.mat) {
+                    mat.base_color = Color::LinearRgba(LinearRgba::new(colour[0], colour[1], colour[2], alpha));
+                    mat.emissive = LinearRgba::new(colour[0] * breath * 0.6, colour[1] * breath * 0.6, colour[2] * breath * 0.6, 1.0);
+                }
+            }
+            FeatureKind::Hazard(h) => {
+                let (colour, alpha, emissive) = hazard_colour_alpha(h, tick, t);
+                if let Some(mut mat) = mats.get_mut(&ent.mat) {
+                    mat.base_color = Color::LinearRgba(LinearRgba::new(colour[0], colour[1], colour[2], alpha));
+                    mat.emissive = LinearRgba::new(emissive[0], emissive[1], emissive[2], 1.0);
+                }
+            }
+        }
+    }
+}
+
+/// Mover position at a fractional render tick: exact at integer ticks, linear between them.
+pub fn interp_pos_at(m: &MoverDef, tick_f: f64) -> [f32; 3] {
+    let t0 = tick_f.floor().max(0.0) as u32;
+    let frac = (tick_f - t0 as f64).clamp(0.0, 1.0) as f32;
+    let a = m.pos_at(t0);
+    let b = m.pos_at(t0 + 1);
+    [0, 1, 2].map(|i| a[i] + (b[i] - a[i]) * frac)
+}
+
+/// Piston charge in `0..=1`: ramps up over the first half of the cycle (the wind-up), peaks at full extension
+/// where the piston slams, fades back during retract. Driven by the same tick-exact cycle as `pos_at`, so a
+/// 180-tick piston charges for 90 ticks and peaks at the slam.
+pub fn piston_charge(m: &MoverDef, tick_f: f64) -> f32 {
+    let t0 = tick_f.floor().max(0.0) as u32;
+    let frac = (tick_f - t0 as f64).clamp(0.0, 1.0) as f32;
+    let c0 = charge_at(m, t0);
+    let c1 = charge_at(m, t0 + 1);
+    c0 + (c1 - c0) * frac
+}
+
+fn charge_at(m: &MoverDef, tick: u32) -> f32 {
+    let period = m.period_ticks as f32;
+    let phase = ((tick as f32) + m.phase_ticks() as f32) % period;
+    let s = phase / period; // [0, 1)
+    if s < 0.5 { s * 2.0 } else { (1.0 - s) * 2.0 } // triangle: 0 -> 1 -> 0 across the cycle
+}
+
+/// Hazard phase for a whole-server tick (tick-exact, like the server's damage evaluation).
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum HazardPhase {
+    Off,
+    /// Warning window before the active part of the cycle.
+    Telegraph,
+    /// Damage is landing this tick.
+    Active,
+}
+
+pub fn hazard_phase(h: &HazardDef, tick: u32) -> HazardPhase {
+    if h.is_active(tick) {
+        HazardPhase::Active
+    } else if h.is_telegraph(tick) {
+        HazardPhase::Telegraph
+    } else {
+        HazardPhase::Off
+    }
+}
+
+/// Colour, alpha and emissive for a hazard at `tick` (phase) and render time `t` (pulse). Active = hot red;
+/// telegraph = orange with a brightness pulse; off = dim ember.
+pub fn hazard_colour_alpha(h: &HazardDef, tick: u32, t: f32) -> ([f32; 3], f32, [f32; 3]) {
+    match hazard_phase(h, tick) {
+        HazardPhase::Active => ([1.00, 0.10, 0.05], 0.55, [1.00, 0.08, 0.02]),
+        HazardPhase::Telegraph => {
+            let pulse = (t * 12.0).sin().abs();
+            let e = 0.5 + pulse;
+            ([1.00, 0.50, 0.00], 0.30 + 0.15 * pulse, [1.00 * e, 0.30 * e, 0.0])
+        }
+        HazardPhase::Off => ([0.40, 0.15, 0.15], 0.10, [0.0, 0.0, 0.0]),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use shinobi_sim::level::{LevelFeatures, MoveAxis};
+
+    fn test_features() -> LevelFeatures {
+        LevelFeatures {
+            zones: vec![
+                ZoneDef { center: [-10.0, 1.0, 0.0], half: [4.0, 1.0, 4.0], tag: "speed_lane".into(), tuning: Default::default() },
+                ZoneDef { center: [10.0, 2.0, 0.0], half: [3.0, 3.0, 3.0], tag: "core_vent".into(), tuning: Default::default() },
+                ZoneDef { center: [0.0, 0.0, 10.0], half: [2.0, 2.0, 2.0], tag: "misc".into(), tuning: Default::default() },
+            ],
+            movers: vec![
+                MoverDef { center: [0.0, 3.0, 0.0], half: [1.0, 1.0, 1.0], axis: MoveAxis::X, distance: 8.0, period_ticks: 180, solid: true, tag: "piston".into(), tuning: Default::default() },
+                MoverDef { center: [0.0, 6.0, 0.0], half: [1.0, 1.0, 1.0], axis: MoveAxis::Z, distance: 4.0, period_ticks: 120, solid: false, tag: "fan".into(), tuning: Default::default() },
+            ],
+            hazards: vec![
+                HazardDef { center: [20.0, 1.0, 0.0], half: [2.0, 2.0, 2.0], period_ticks: 180, telegraph_ticks: 36, damage: 25.0, tag: "saw".into(), tuning: Default::default() },
+            ],
+        }
+    }
+
+    #[test]
+    fn zone_colour_picks_tag_palette() {
+        let f = test_features();
+        let (c, a) = zone_colour_alpha(&f.zones[0]);
+        assert_eq!(c, [0.15, 0.8, 1.0]);
+        assert!((0.15..0.4).contains(&a));
+        let (c, _a) = zone_colour_alpha(&f.zones[1]);
+        assert_eq!(c, [0.2, 0.45, 1.0]);
+        let (c, _) = zone_colour_alpha(&f.zones[2]);
+        assert!(c.iter().all(|v| *v >= 0.4 && *v <= 0.8)); // neutral, never competes with lanes/vent
+    }
+
+    #[test]
+    fn hazard_phase_colours_match_state() {
+        let h = &test_features().hazards[0];
+        // period 180, telegraph 36, active_ticks default 1: tick 0 active, 144 telegraph, 100 off
+        let (c, a, _) = hazard_colour_alpha(h, 0, 0.0);
+        assert_eq!(c, [1.0, 0.1, 0.05]);
+        assert!(a > 0.4);
+        let (c, a, _) = hazard_colour_alpha(h, 144, 0.0);
+        assert_eq!(c, [1.0, 0.5, 0.0]);
+        assert!(a >= 0.3);
+        let (c, a, _) = hazard_colour_alpha(h, 100, 0.0);
+        assert_eq!(c, [0.4, 0.15, 0.15]);
+        assert!(a < 0.2);
+        // the telegraph pulse moves with render time even at a fixed tick
+        let (_, a0, _) = hazard_colour_alpha(h, 144, 0.0);
+        let (_, a1, _) = hazard_colour_alpha(h, 144, 0.25); // |sin(3)| > 0 -> brighter pulse
+        assert!(a1 > a0);
+    }
+
+    #[test]
+    fn mover_interpolation_is_exact_at_integer_ticks() {
+        let f = test_features();
+        let m = &f.movers[0]; // x: 0 -> 8 over 180 ticks, period 180
+        let start = interp_pos_at(m, 0.0);
+        assert!((start[0] - 0.0).abs() < 1e-6 && start[1] == 3.0 && start[2] == 0.0);
+        let mid = interp_pos_at(m, 90.0);
+        assert!((mid[0] - 4.0).abs() < 1e-6, "{mid:?}"); // half distance at half the leg
+        let end = interp_pos_at(m, 180.0);
+        assert!((end[0] - 8.0).abs() < 1e-6, "{end:?}"); // full extension at leg end
+        let back = interp_pos_at(m, 360.0);
+        assert!((back[0] - 0.0).abs() < 1e-6, "{back:?}"); // back at the start after a full cycle
+    }
+
+    #[test]
+    fn mover_interpolation_stays_inside_the_leg() {
+        let f = test_features();
+        let m = &f.movers[0];
+        for f64_t in [0.0, 0.5, 45.25, 89.9, 90.0, 179.5, 180.0] {
+            let p = interp_pos_at(m, f64_t);
+            assert!(p[0] >= 0.0 && p[0] <= 8.0, "{f64_t} -> {p:?}");
+            assert_eq!((p[1], p[2]), (3.0, 0.0));
+        }
+        // z axis ghost mover: 0 -> 4 over 120 ticks
+        let z = &f.movers[1];
+        let p = interp_pos_at(z, 60.0);
+        assert!((p[2] - 2.0).abs() < 1e-6, "{p:?}");
+    }
+
+    #[test]
+    fn piston_charge_ramps_over_half_cycle_and_peaks_at_slam() {
+        let f = test_features();
+        let m = &f.movers[0]; // period 180: 90-tick wind-up
+        assert!((charge_at(m, 0) - 0.0).abs() < 1e-6);
+        assert!((charge_at(m, 45) - 0.5).abs() < 1e-6);
+        assert!((charge_at(m, 90) - 1.0).abs() < 1e-6); // full extension: peak charge, slam moment
+        assert!((charge_at(m, 135) - 0.5).abs() < 1e-6);
+        assert!((charge_at(m, 180) - 0.0).abs() < 1e-6); // retracted and cool again
+        // fractional interpolation between ticks stays within [0, 1]
+        for f64_t in [0.0, 1.5, 89.5, 90.5, 179.9] {
+            let c = piston_charge(m, f64_t);
+            assert!(c >= 0.0 && c <= 1.0, "{f64_t} -> {c}");
+        }
+    }
+
+    #[test]
+    fn placement_matches_centre_and_half() {
+        let f = test_features();
+        // cuboid scale is 2x half, centred on the def centre: placement readable at any distance because the
+        // silhouette is the feature's true volume.
+        for m in &f.movers {
+            let s = Vec3::from(m.half) * 2.0;
+            assert!((s - Vec3::splat(2.0)).length() < 1e-6);
+        }
+        for z in &f.zones {
+            let s = Vec3::from(z.half) * 2.0;
+            assert!(s.x > 0.0 && s.y > 0.0 && s.z > 0.0);
+        }
+        for h in &f.hazards {
+            let s = Vec3::from(h.half) * 2.0;
+            assert!(s.x > 0.0 && s.y > 0.0 && s.z > 0.0);
+        }
+    }
+
+    #[test]
+    fn feature_count_is_bounded_by_the_level_file() {
+        let f = test_features();
+        let count = f.zones.len() + f.movers.len() + f.hazards.len();
+        assert_eq!(count, 6);
+        assert!(f.is_empty() == false);
+        assert!(LevelFeatures::default().is_empty());
+    }
+}
diff --git a/crates/shinobi-sim/src/features.rs b/crates/shinobi-sim/src/features.rs
new file mode 100644
index 0000000..c620c94
--- /dev/null
+++ b/crates/shinobi-sim/src/features.rs
@@ -0,0 +1,337 @@
+//! Deterministic runtime for `zone`, `mover` and `hazard` level directives.
+//!
+//! Movers are an exact function of the server tick (`MotionPath` fixed point). Solid movers own a world collider that
+//! is repositioned before the player loop; a player in the swept volume is displaced along the travel axis so a fast
+//! mover cannot tunnel through them. Zones and hazards are axis-aligned trigger volumes evaluated after movement.
+
+use std::collections::BTreeMap;
+
+use shinobi_proto::quant::{dq_pos3, q_pos3, POS_SCALE};
+
+use crate::character::{sync_body_colliders, Cfg, PhysicsWorld};
+use crate::combat::GROUP_WORLD;
+use crate::level::{HazardDef, LevelFeatures, MoveAxis, MoverDef, ZoneDef};
+use crate::obstacle::MotionPath;
+use crate::rapier3d::prelude::*;
+use crate::tick::Player;
+
+pub const LEVEL_HAZARD_ID_BASE: u16 = 0xE000;
+pub use crate::level::MAX_LEVEL_HAZARDS;
+
+pub fn hazard_source_id(index: usize) -> u16 {
+    LEVEL_HAZARD_ID_BASE + index as u16
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum FeatureEvent {
+    ZoneEnter { tick: u32, zone: u16, player: u16 },
+    ZoneExit { tick: u32, zone: u16, player: u16 },
+    HazardHit { tick: u32, hazard: u16, player: u16, amount: f32 },
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct HazardContact {
+    pub victim: usize,
+    pub amount: f32,
+    pub source: u16,
+}
+
+struct MoverRuntime {
+    index: u16,
+    collider: ColliderHandle,
+}
+
+#[derive(Clone, Copy, Default)]
+struct ZoneMemory {
+    inside: bool,
+    ready_tick: u32,
+}
+
+#[derive(Default)]
+pub struct Features {
+    defs: LevelFeatures,
+    movers: Vec<MoverRuntime>,
+    zone_memory: BTreeMap<u16, Vec<ZoneMemory>>,
+    hazard_hit: BTreeMap<(u16, u16), u32>,
+    events: Vec<FeatureEvent>,
+    contacts: Vec<HazardContact>,
+}
+
+impl MoverDef {
+    pub fn motion_path(&self) -> MotionPath {
+        let a = q_pos3(self.center);
+        let mut b = a;
+        let d = (self.distance * POS_SCALE).round() as i32;
+        let i = self.axis.index();
+        b[i] = b[i].saturating_add(d);
+        MotionPath::PingPong { a, b, period: self.period_ticks.min(u16::MAX as u32) as u16 }
+    }
+
+    pub fn phase_ticks(&self) -> u32 {
+        self.tuning.get("phase_ticks").copied().map_or(0, |v| v.max(0.0) as u32)
+    }
+
+    pub fn pos_at(&self, tick: u32) -> [f32; 3] {
+        let path = crate::obstacle::ObstacleDesc {
+            id: 0,
+            kind: 0,
+            start_tick: 0,
+            end_tick: 0,
+            half: [0; 3],
+            path: self.motion_path(),
+        };
+        dq_pos3(path.pos_at(tick.saturating_add(self.phase_ticks())))
+    }
+}
+
+impl HazardDef {
+    pub fn active_ticks(&self) -> u32 {
+        self.tuning.get("active_ticks").copied().map_or(1, |v| (v.max(0.0) as u32).max(1))
+    }
+
+    pub fn phase_ticks(&self) -> u32 {
+        self.tuning.get("phase_ticks").copied().map_or(0, |v| v.max(0.0) as u32) % self.period_ticks.max(1)
+    }
+
+    pub fn local_tick(&self, tick: u32) -> u32 {
+        let cycle = self.period_ticks.max(1) as u64;
+        let phase = self.phase_ticks() as u64 % cycle;
+        ((tick as u64 % cycle + cycle - phase) % cycle) as u32
+    }
+
+    pub fn is_active(&self, tick: u32) -> bool {
+        self.local_tick(tick) < self.active_ticks()
+    }
+
+    pub fn is_telegraph(&self, tick: u32) -> bool {
+        let cycle = self.period_ticks.max(1);
+        let local = self.local_tick(tick);
+        !self.is_active(tick) && self.telegraph_ticks > 0 && local >= cycle.saturating_sub(self.telegraph_ticks)
+    }
+
+    fn activation(&self, tick: u32) -> u32 {
+        let cycle = self.period_ticks.max(1) as u64;
+        let t = tick as u64 + cycle - (self.phase_ticks() as u64 % cycle);
+        (t / cycle) as u32
+    }
+}
+
+impl ZoneDef {
+    pub const CORE_VENT: &'static str = "core_vent";
+
+    pub fn cooldown_ticks(&self) -> u32 {
+        self.tuning.get("cooldown_ticks").copied().map_or(0, |v| v.max(0.0) as u32)
+    }
+
+    pub fn fill_ticks(&self) -> u32 {
+        self.tuning.get("fill_ticks").copied().map_or(90, |v| v.max(1.0) as u32)
+    }
+
+    pub fn reveal_ticks(&self) -> u32 {
+        self.tuning.get("reveal_ticks").copied().map_or(300, |v| v.max(0.0) as u32)
+    }
+}
+
+impl Features {
+    pub fn is_empty(&self) -> bool {
+        self.defs.is_empty()
+    }
+
+    pub fn defs(&self) -> &LevelFeatures {
+        &self.defs
+    }
+
+    pub fn events(&self) -> &[FeatureEvent] {
+        &self.events
+    }
+
+    pub fn hazard_contacts(&self) -> &[HazardContact] {
+        &self.contacts
+    }
+
+    pub fn mover_position(&self, index: usize, tick: u32) -> Option<[f32; 3]> {
+        self.defs.movers.get(index).map(|m| m.pos_at(tick))
+    }
+
+    pub fn forget_player(&mut self, id: u16) {
+        self.zone_memory.remove(&id);
+        self.hazard_hit.retain(|(_, p), _| *p != id);
+    }
+
+    pub fn load(&mut self, defs: LevelFeatures, world: &mut PhysicsWorld) {
+        self.clear(world);
+        self.movers = defs
+            .movers
+            .iter()
+            .enumerate()
+            .filter(|(_, m)| m.solid)
+            .map(|(i, m)| {
+                let p = m.pos_at(0);
+                let collider = world.colliders.insert(
+                    ColliderBuilder::cuboid(m.half[0], m.half[1], m.half[2])
+                        .position(Isometry::translation(p[0], p[1], p[2]))
+                        .collision_groups(InteractionGroups::new(GROUP_WORLD, Group::ALL))
+                        .build(),
+                );
+                MoverRuntime { index: i as u16, collider }
+            })
+            .collect();
+        self.defs = defs;
+    }
+
+    pub fn clear(&mut self, world: &mut PhysicsWorld) {
+        for m in self.movers.drain(..) {
+            world.colliders.remove(m.collider, &mut world.islands, &mut world.bodies, false);
+        }
+        self.defs = LevelFeatures::default();
+        self.zone_memory.clear();
+        self.hazard_hit.clear();
+        self.events.clear();
+        self.contacts.clear();
+    }
+
+    /// Move solid colliders to their exact tick position and push any player caught in the swept volume.
+    pub fn begin_tick(&mut self, world: &mut PhysicsWorld, players: &mut [Player], tick: u32, cfg: &Cfg) {
+        self.events.clear();
+        self.contacts.clear();
+        if self.movers.is_empty() {
+            return;
+        }
+        let player_half = player_half(cfg);
+        for m in &self.movers {
+            let Some((def, prev, next)) = self.advance_mover(world, m, tick) else { continue };
+            for p in players.iter_mut().filter(|p| p.vitals.alive()) {
+                push_out_of_sweep(world, p.ch.body, prev, next, def.half, def.axis, player_half);
+            }
+        }
+    }
+
+    /// Client-safe path: move the solid mover colliders to `tick` and push one body out of every swept face, with
+    /// the same tick-exact math as the server. No events, contacts, zones or hazards: those stay server-only.
+    pub fn begin_tick_single(&self, world: &mut PhysicsWorld, body: RigidBodyHandle, tick: u32, cfg: &Cfg) {
+        if self.movers.is_empty() {
+            return;
+        }
+        let player_half = player_half(cfg);
+        for m in &self.movers {
+            let Some((def, prev, next)) = self.advance_mover(world, m, tick) else { continue };
+            push_out_of_sweep(world, body, prev, next, def.half, def.axis, player_half);
+        }
+    }
+
+    fn advance_mover<'a>(&'a self, world: &mut PhysicsWorld, m: &MoverRuntime, tick: u32) -> Option<(&'a MoverDef, [f32; 3], [f32; 3])> {
+        let def = self.defs.movers.get(m.index as usize)?;
+        let prev = def.pos_at(tick.saturating_sub(1));
+        let next = def.pos_at(tick);
+        if let Some(c) = world.colliders.get_mut(m.collider) {
+            c.set_position(Isometry::translation(next[0], next[1], next[2]));
+        }
+        Some((def, prev, next))
+    }
+
+    /// Zone edges and hazard contacts for this tick. `damaging` is false while the match is frozen.
+    pub fn end_tick(&mut self, world: &PhysicsWorld, players: &mut [Player], tick: u32, cfg: &Cfg, damaging: bool) {
+        let player_half = [cfg.radius, cfg.half_height + cfg.radius, cfg.radius];
+
+        for (zi, z) in self.defs.zones.iter().enumerate() {
+            for p in players.iter_mut() {
+                let inside = overlaps(z.center, z.half, p.pos(world), player_half);
+                let mem = self.zone_memory.entry(p.id).or_insert_with(|| vec![ZoneMemory::default(); self.defs.zones.len()]);
+                let Some(m) = mem.get_mut(zi) else { continue };
+                let was = m.inside;
+                if was && !inside {
+                    m.inside = false;
+                    m.ready_tick = tick.saturating_add(z.cooldown_ticks());
+                    self.events.push(FeatureEvent::ZoneExit { tick, zone: zi as u16, player: p.id });
+                } else if !was && inside && tick >= m.ready_tick {
+                    m.inside = true;
+                    self.events.push(FeatureEvent::ZoneEnter { tick, zone: zi as u16, player: p.id });
+                }
+                if damaging && inside && z.tag == ZoneDef::CORE_VENT && p.vitals.alive() {
+                    p.shield.vent_tick(tick, z.fill_ticks(), z.cooldown_ticks());
+                }
+            }
+        }
+        self.zone_memory.retain(|id, _| players.iter().any(|p| p.id == *id));
+
+        if !damaging {
+            return;
+        }
+        for (hi, h) in self.defs.hazards.iter().enumerate() {
+            if !h.is_active(tick) {
+                continue;
+            }
+            let activation = h.activation(tick);
+            for (pi, p) in players.iter().enumerate() {
+                if !p.vitals.alive() || !overlaps(h.center, h.half, p.pos(world), player_half) {
+                    continue;
+                }
+                let key = (hi as u16, p.id);
+                if self.hazard_hit.get(&key) == Some(&activation) {
+                    continue;
+                }
+                self.hazard_hit.insert(key, activation);
+                self.events.push(FeatureEvent::HazardHit { tick, hazard: hi as u16, player: p.id, amount: h.damage });
+                if h.damage > 0.0 {
+                    self.contacts.push(HazardContact { victim: pi, amount: h.damage, source: hazard_source_id(hi) });
+                }
+            }
+        }
+    }
+}
+
+fn overlaps(center: [f32; 3], half: [f32; 3], pos: [f32; 3], player_half: [f32; 3]) -> bool {
+    (0..3).all(|i| (pos[i] - center[i]).abs() <= half[i] + player_half[i])
+}
+
+fn player_half(cfg: &Cfg) -> [f32; 3] {
+    [cfg.radius, cfg.half_height + cfg.radius, cfg.radius]
+}
+
+fn push_out_of_sweep(
+    world: &mut PhysicsWorld,
+    body: RigidBodyHandle,
+    prev: [f32; 3],
+    next: [f32; 3],
+    half: [f32; 3],
+    axis: MoveAxis,
+    player_half: [f32; 3],
+) {
+    let t = world.bodies[body].translation();
+    let pos = [t.x, t.y, t.z];
+    let a = axis.index();
+    let d = next[a] - prev[a];
+    if d > 0.0 && pos[a] < prev[a] {
+        return;
+    }
+    if d < 0.0 && pos[a] > prev[a] {
+        return;
+    }
+    let (lo, hi) = if d >= 0.0 { (prev[a], next[a]) } else { (next[a], prev[a]) };
+    for i in 0..3 {
+        let hit = if i == a {
+            pos[i] + player_half[i] >= lo - half[i] && pos[i] - player_half[i] <= hi + half[i]
+        } else {
+            (pos[i] - next[i]).abs() <= half[i] + player_half[i]
+        };
+        if !hit {
+            return;
+        }
+    }
+    if axis != MoveAxis::Y && pos[1] - player_half[1] >= next[1] + half[1] - 0.08 {
+        return;
+    }
+    let target = if d > 0.0 {
+        next[a] + half[a] + player_half[a] + 0.002
+    } else if d < 0.0 {
+        next[a] - half[a] - player_half[a] - 0.002
+    } else if pos[a] >= next[a] {
+        next[a] + half[a] + player_half[a] + 0.002
+    } else {
+        next[a] - half[a] - player_half[a] - 0.002
+    };
+    let mut to = pos;
+    to[a] = target;
+    world.bodies[body].set_position(Isometry::translation(to[0], to[1], to[2]), true);
+    sync_body_colliders(world, body);
+}
diff --git a/crates/shinobi-sim/src/shield.rs b/crates/shinobi-sim/src/shield.rs
new file mode 100644
index 0000000..90ce48e
--- /dev/null
+++ b/crates/shinobi-sim/src/shield.rs
@@ -0,0 +1,171 @@
+//! Kinetic Battery and Aegis aura (`docs/weapons/shield.md`). Server-authoritative, passive, no movement impact.
+
+pub const BATTERY_MAX: u16 = 1000;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ShieldCfg {
+    pub blocked_star_charge: f32,
+    pub parry_charge: f32,
+    pub aura_ticks: u32,
+    pub aura_damage_mult: f32,
+}
+
+impl Default for ShieldCfg {
+    fn default() -> Self {
+        Self { blocked_star_charge: 0.08, parry_charge: 0.25, aura_ticks: 300, aura_damage_mult: 1.2 }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ShieldState {
+    /// Fixed 0..=1000. `BATTERY_MAX` is the trigger and is consumed by the aura.
+    pub battery: u16,
+    /// Tick after which the active aura is over (exclusive). 0 with `aura_total == 0` means inactive.
+    pub aura_until: u32,
+    /// Authored duration of the active aura, for the HUD; 0 when inactive.
+    pub aura_total: u16,
+    /// Ticks of continuous `core_vent` occupation already banked toward `fill_ticks`.
+    pub vent_fill_ticks: u32,
+    /// Tick before which this player's `core_vent` is cooling down.
+    pub vent_ready_tick: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ShieldTick {
+    None,
+    AuraStart,
+    AuraEnd,
+}
+
+fn charge_q(fraction: f32) -> u16 {
+    libm::roundf(fraction.clamp(0.0, 1.0) * BATTERY_MAX as f32) as u16
+}
+
+impl ShieldState {
+    pub fn battery_frac(&self) -> f32 {
+        self.battery as f32 / BATTERY_MAX as f32
+    }
+
+    pub fn aura_active(&self, tick: u32) -> bool {
+        self.aura_total != 0 && tick < self.aura_until
+    }
+
+    pub fn aura_ticks_left(&self, tick: u32) -> u16 {
+        if self.aura_active(tick) {
+            self.aura_until.saturating_sub(tick).min(u16::MAX as u32) as u16
+        } else {
+            0
+        }
+    }
+
+    /// Add a charge fraction; the aura trigger is resolved by `update` at the end of the tick.
+    pub fn add_charge(&mut self, fraction: f32) {
+        self.battery = self.battery.saturating_add(charge_q(fraction)).min(BATTERY_MAX);
+    }
+
+    pub fn blocked_star(&mut self, cfg: &ShieldCfg) {
+        self.add_charge(cfg.blocked_star_charge);
+    }
+
+    pub fn parry(&mut self, cfg: &ShieldCfg) {
+        self.add_charge(cfg.parry_charge);
+    }
+
+    /// One tick of `core_vent` occupation. `true` when this tick completes a fill.
+    pub fn vent_tick(&mut self, tick: u32, fill_ticks: u32, cooldown_ticks: u32) -> bool {
+        if tick < self.vent_ready_tick {
+            return false;
+        }
+        let fill = fill_ticks.max(1);
+        self.vent_fill_ticks = self.vent_fill_ticks.saturating_add(1).min(fill);
+        let banked = (self.vent_fill_ticks as u64 * BATTERY_MAX as u64 / fill as u64) as u16;
+        self.battery = self.battery.max(banked);
+        if self.vent_fill_ticks >= fill {
+            self.battery = BATTERY_MAX;
+            self.vent_fill_ticks = 0;
+            self.vent_ready_tick = tick.saturating_add(cooldown_ticks);
+            return true;
+        }
+        false
+    }
+
+    /// End-of-tick transition: expire an old aura, then start one if the Battery is full. Cannot retrigger while
+    /// active; a Battery that filled during the aura starts the next one on the expiry tick.
+    pub fn update(&mut self, tick: u32, cfg: &ShieldCfg) -> ShieldTick {
+        if self.aura_total != 0 && tick >= self.aura_until {
+            self.aura_total = 0;
+            self.aura_until = 0;
+            if self.battery < BATTERY_MAX {
+                return ShieldTick::AuraEnd;
+            }
+        }
+        if self.aura_total == 0 && self.battery >= BATTERY_MAX {
+            self.battery = 0;
+            self.aura_total = cfg.aura_ticks.max(1).min(u16::MAX as u32) as u16;
+            self.aura_until = tick.saturating_add(self.aura_total as u32);
+            return ShieldTick::AuraStart;
+        }
+        ShieldTick::None
+    }
+
+    /// Death cancels only the aura. The Battery and the vent cooldown persist to the next spawn.
+    pub fn on_death(&mut self) {
+        self.aura_until = 0;
+        self.aura_total = 0;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn blocked_and_parry_charges_are_exact_and_saturate() {
+        let cfg = ShieldCfg::default();
+        let mut s = ShieldState::default();
+        s.blocked_star(&cfg);
+        assert_eq!(s.battery, 80);
+        s.parry(&cfg);
+        assert_eq!(s.battery, 330);
+        for _ in 0..20 {
+            s.parry(&cfg);
+        }
+        assert_eq!(s.battery, BATTERY_MAX);
+    }
+
+    #[test]
+    fn vent_fills_progressively_and_keeps_progress_when_you_leave() {
+        let mut s = ShieldState::default();
+        assert!(!s.vent_tick(10, 4, 100));
+        assert!(!s.vent_tick(11, 4, 100));
+        assert_eq!(s.battery, 500);
+        // outside: no call, progress and Battery stay; re-entry continues
+        assert!(!s.vent_tick(20, 4, 100));
+        assert_eq!(s.battery, 750);
+        assert!(s.vent_tick(21, 4, 100));
+        assert_eq!(s.battery, BATTERY_MAX);
+        assert_eq!(s.vent_ready_tick, 121);
+        assert_eq!(s.vent_fill_ticks, 0);
+        assert!(!s.vent_tick(120, 4, 100), "cooling down");
+        assert_eq!(s.vent_fill_ticks, 0);
+        assert!(s.vent_tick(121, 1, 100), "cooldown over: a one-tick fill completes");
+        assert_eq!(s.battery, BATTERY_MAX);
+    }
+
+    #[test]
+    fn aura_lasts_its_full_duration_and_only_one_runs_at_a_time() {
+        let cfg = ShieldCfg::default();
+        let mut s = ShieldState::default();
+        s.battery = BATTERY_MAX;
+        assert_eq!(s.update(100, &cfg), ShieldTick::AuraStart);
+        assert_eq!(s.battery, 0);
+        assert_eq!(s.aura_ticks_left(100), 300);
+        assert!(s.aura_active(399));
+        assert!(!s.aura_active(400));
+        // refilled during the aura: the next one starts on the expiry tick
+        s.battery = BATTERY_MAX;
+        assert_eq!(s.update(399, &cfg), ShieldTick::None);
+        assert_eq!(s.update(400, &cfg), ShieldTick::AuraStart);
+        assert_eq!(s.aura_ticks_left(400), 300);
+    }
+}
