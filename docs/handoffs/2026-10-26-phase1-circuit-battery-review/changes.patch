+    }
+    let telegraph_ticks = parse_ticks(tokens[7], err)?;
+    if telegraph_ticks > period_ticks {
+        return Err(err("telegraph_ticks must be <= period_ticks"));
+    }
+    let damage = parse_number(tokens[8], err)?;
+    if damage < 0.0 {
