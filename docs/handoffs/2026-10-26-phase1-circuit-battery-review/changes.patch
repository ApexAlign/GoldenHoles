+#[test]
+fn six_data_cubes_are_supported_clear_and_on_permanent_geometry() {
+    let l = load();
+    for p in &l.pickups {
+        assert!(!solid(&l, p.pos), "pickup {:?} is inside geometry", p.pos);
+        let support = l.level.boxes.iter().find(|b| {
+            surface_at(b, p.pos[0], p.pos[2]).map_or(false, |h| (p.pos[1] - h - 1.0).abs() < 0.3)
+        });
+        let support =
+            support.unwrap_or_else(|| panic!("pickup {:?} is not 1 m above a surface", p.pos));
+        assert_eq!(
+            support.hp, 0.0,
+            "pickup {:?} is above a breaking box",
+            p.pos
+        );
+        for b in &l.level.boxes {
+            if std::ptr::eq(b, support) {
+                continue;
+            }
+            let spans_body = b.center[1] + b.half[1] > p.pos[1] - 0.5
+                && b.center[1] - b.half[1] < p.pos[1] + 1.5;
+            if spans_body {
+                assert!(
+                    box_dist_xz(b, p.pos) >= 1.0,
+                    "pickup {:?} is too close to {b:?}",
+                    p.pos
+                );
+            }
+        }
+        // no low ceiling over a cube
+        for dy in [1.0, 2.5, 3.5] {
+            assert!(
+                !solid(&l, [p.pos[0], p.pos[1] + dy, p.pos[2]]),
+                "pickup {:?} has a low ceiling",
+                p.pos
+            );
+        }
+    }
+    assert_eq!(
+        l.pickups.iter().filter(|p| p.pos[1] < 2.0).count(),
+        4,
+        "four lane-mouth cubes"
+    );
+    assert_eq!(
+        l.pickups.iter().filter(|p| p.pos[1] > 9.0).count(),
+        2,
+        "two upper-ring cubes"
+    );
+}
