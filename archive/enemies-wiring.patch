+/// Every player hitbox back at "now" (position and enabled state). Run before anything that queries the
+/// world after the attackers (hazards), since the last attacker may have left them rewound.
+pub fn restore_hitboxes(players: &[Player], world: &mut PhysicsWorld) {
+    for p in players {
+        let t = world.bodies[p.ch.body].translation();
+        let alive = p.vitals.alive();
+        if let Some(col) = world.colliders.get_mut(p.vitals.hitbox) {
+            col.set_position(Isometry::translation(t.x, t.y, t.z));
+            col.set_collision_groups(if alive { hitbox_groups() } else { InteractionGroups::none() });
+        }
+    }
+}
