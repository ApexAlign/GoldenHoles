+//! `levels/ffa_circuit.lvl` (generated by `scripts/gen_circuit_level.py`): the Circuit-Breaker Arena Phase 1 blockout
+//! plus its zone/mover layer. Pinned: the 100 x 100 m sealed deck over void, the 30 x 30 m split-level nexus and its
+//! four pit ramps, the four 10 m data lanes with 8 m wall-run faces, the ten outer-ring spawns and six data-cube pickups,
+//! the upper ring and its 2 m gaps, static access to it, the box budget and the destructible gameplay share. Also pinned:
+//! eight solid piston movers (four 3 s pairs), four `speed_lane` zones, the `core_vent` zone, their exact tuning and
+//! fingerprint, and that no feature volume blocks a spawn, pickup or main route. No `hazard` lines ship yet.
+
+use std::collections::{BTreeMap, HashSet, VecDeque};
+use std::f32::consts::{PI, TAU};
+use std::time::Duration;
+
+use shinobi_proto::intent::{ClientPacket, PlayerIntent, ViewState, PITCH_LEVEL};
+use shinobi_proto::quant::{dq_yaw, q_yaw};
+use shinobi_sim::character::{Cfg, PhysicsWorld};
+use shinobi_sim::level::{parse_level_file, unwalkable_obstacles, LevelBox, LevelFile, MoveAxis, MoverDef, ZoneDef};
+use shinobi_sim::power::PowerKind;
+use shinobi_sim::rapier3d::prelude::*;
+use shinobi_sim::spawn::blocked;
+use shinobi_sim::tick::Server;
+
+const HALF: f32 = 50.0;
+const PIT: f32 = 8.0;
+const PIT_FLOOR: f32 = -6.0;
+const NEXUS: f32 = 15.0;
+const UPPER: f32 = 9.0;
+const WALL: f32 = 41.0;
+const LANE_IN: f32 = 13.0;
+const LANE_OUT: f32 = 41.0;
+const LANE_HALF: f32 = 5.0;
+const WALL_TOP: f32 = 8.0;
+
+fn level_text() -> String {
+    let path =
+        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../levels/ffa_circuit.lvl");
+    std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("{}: {e}", path.display()))
+}
+
+fn load() -> LevelFile {
+    parse_level_file(&level_text()).unwrap_or_else(|e| panic!("ffa_circuit.lvl: {e}"))
+}
+
+fn world(l: &LevelFile) -> PhysicsWorld {
+    let mut w = PhysicsWorld {
+        bodies: RigidBodySet::new(),
+        colliders: ColliderSet::new(),
+        islands: IslandManager::new(),
+        queries: QueryPipeline::new(),
+    };
+    l.level.insert_into(&mut w);
+    w.queries.update(&w.colliders);
+    w
+}
+
+fn inside(b: &LevelBox, p: [f32; 3]) -> bool {
+    let (s, c) = b.rot_z.sin_cos();
+    let (dx, dy) = (p[0] - b.center[0], p[1] - b.center[1]);
+    let (u, v) = (dx * c + dy * s, -dx * s + dy * c);
+    u.abs() <= b.half[0] && v.abs() <= b.half[1] && (p[2] - b.center[2]).abs() <= b.half[2]
+}
+
+fn surface_at(b: &LevelBox, x: f32, z: f32) -> Option<f32> {
+    if (z - b.center[2]).abs() > b.half[2] {
+        return None;
+    }
+    let (s, c) = b.rot_z.sin_cos();
+    let u = (x - b.center[0] + b.half[1] * s) / c;
+    (u.abs() <= b.half[0]).then(|| b.center[1] + u * s + b.half[1] * c)
+}
+
+fn top_at(l: &LevelFile, x: f32, z: f32) -> Option<f32> {
+    l.level
+        .boxes
+        .iter()
+        .filter_map(|b| surface_at(b, x, z))
+        .fold(None, |m: Option<f32>, h| Some(m.map_or(h, |m| m.max(h))))
+}
+
+fn solid(l: &LevelFile, p: [f32; 3]) -> bool {
+    l.level.boxes.iter().any(|b| inside(b, p))
+}
+
+fn d2(a: [f32; 3], b: [f32; 3]) -> f32 {
+    ((a[0] - b[0]).powi(2) + (a[2] - b[2]).powi(2)).sqrt()
+}
+
+fn d3(a: [f32; 3], b: [f32; 3]) -> f32 {
+    ((a[0] - b[0]).powi(2) + (a[1] - b[1]).powi(2) + (a[2] - b[2]).powi(2)).sqrt()
+}
+
+fn box_dist_xz(b: &LevelBox, p: [f32; 3]) -> f32 {
+    let (s, c) = b.rot_z.sin_cos();
+    let (dx, dy) = (p[0] - b.center[0], p[1] - b.center[1]);
+    let (u, _v) = (dx * c + dy * s, -dx * s + dy * c);
+    let ex = (u.abs() - b.half[0]).max(0.0);
+    let ez = (p[2] - b.center[2]).abs() - b.half[2];
+    (ex * ex + ez.max(0.0) * ez.max(0.0)).sqrt()
+}
+
+/// `true` for a box under a `# --- structural:` section header. The generator is the source of that classification;
+/// gameplay sections are the breakable data racks plus the permanent plaza hard cover.
+fn structural_sections(text: &str) -> Vec<bool> {
+    let mut structural = true;
+    let mut out = Vec::new();
+    for raw in text.lines() {
+        if raw.starts_with("# ---") {
+            structural = raw.starts_with("# --- structural:");
+            continue;
+        }
+        let line = raw.split('#').next().unwrap().trim_start();
+        if line.starts_with("box ") || line.starts_with("dbox ") {
+            out.push(structural);
+        }
+    }
+    out
+}
+
+fn is_ring_segment(b: &LevelBox) -> bool {
+    let top = b.center[1] + b.half[1];
+    let long = b.half[0].max(b.half[2]);
+    (top - UPPER).abs() < 0.01 && (b.half[1] - 0.3).abs() < 0.01 && long >= 5.9
+}
+
+fn is_lane_wall(b: &LevelBox) -> bool {
+    (b.center[1] + b.half[1] - WALL_TOP).abs() < 0.01 && (b.half[1] - 4.0).abs() < 0.01
+}
+
+fn first_hit(w: &PhysicsWorld, from: [f32; 3], to: [f32; 3]) -> Option<f32> {
+    let d = [to[0] - from[0], to[1] - from[1], to[2] - from[2]];
+    let len = (d[0] * d[0] + d[1] * d[1] + d[2] * d[2]).sqrt();
+    if len < 1e-3 {
+        return None;
+    }
+    let ray = Ray::new(
+        Point::new(from[0], from[1], from[2]),
+        vector![d[0] / len, d[1] / len, d[2] / len],
+    );
+    w.queries
+        .cast_ray(
+            &w.bodies,
+            &w.colliders,
+            &ray,
+            len,
+            true,
+            QueryFilter::default(),
+        )
+        .map(|(_, t)| t)
+}
+
+fn near_box(b: &LevelBox, p: [f32; 3], pad: f32) -> bool {
+    inside(
+        &LevelBox {
+            half: [b.half[0] + pad, b.half[1] + pad, b.half[2] + pad],
+            ..*b
+        },
+        p,
+    )
+}
+
+fn zone_aabb(z: &ZoneDef) -> ([f32; 3], [f32; 3]) {
+    (z.center, z.half)
+}
+
+fn mover_swept(m: &MoverDef) -> ([f32; 3], [f32; 3]) {
+    let mut lo = [m.center[0] - m.half[0], m.center[1] - m.half[1], m.center[2] - m.half[2]];
+    let mut hi = [m.center[0] + m.half[0], m.center[1] + m.half[1], m.center[2] + m.half[2]];
+    let a = m.axis.index();
+    lo[a] = lo[a].min(m.center[a] + m.distance - m.half[a]);
+    hi[a] = hi[a].max(m.center[a] + m.distance + m.half[a]);
+    (lo, hi)
+}
+
+fn in_aabb(lo: [f32; 3], hi: [f32; 3], p: [f32; 3], pad: f32) -> bool {
+    (0..3).all(|i| p[i] >= lo[i] - pad && p[i] <= hi[i] + pad)
+}
+
+fn aabbs_overlap(a: ([f32; 3], [f32; 3]), b: ([f32; 3], [f32; 3])) -> bool {
+    (0..3).all(|i| a.0[i] < b.1[i] - 1e-3 && b.0[i] < a.1[i] - 1e-3)
+}
+
+fn angle_diff(to: f32, from: f32) -> f32 {
+    (to - from + PI).rem_euclid(TAU) - PI
+}
+
+/// Points on the main traversal routes a piston must never sweep through: lane centrelines and mouths, pit-ramp
+/// centrelines, the nexus cardinal crossing, and the upper ring.
+fn main_route_points() -> Vec<[f32; 3]> {
+    let mut out = Vec::new();
+    for t in LANE_IN as i32..=LANE_OUT as i32 {
+        let f = t as f32;
+        for (x, z) in [(f, 0.0), (-f, 0.0), (0.0, f), (0.0, -f)] {
+            out.push([x, 1.0, z]);
+            out.push([x, 2.5, z]);
+        }
+    }
+    for t in [LANE_IN, 14.0, 15.0] {
+        for u in -5i32..=5 {
+            let u = u as f32;
+            for (x, z) in [(t, u), (-t, u), (u, t), (u, -t)] {
+                out.push([x, 1.0, z]);
+                out.push([x, 2.5, z]);
+            }
+        }
+    }
+    for zc in [-6.5f32, -5.0, 5.0, 6.5] {
+        for x in -8i32..=8 {
+            out.push([x as f32, 1.0, zc]);
+            out.push([x as f32, 2.5, zc]);
+        }
+    }
+    for t in -15i32..=15 {
+        let f = t as f32;
+        for (x, z) in [(f, 0.0), (0.0, f)] {
+            out.push([x, 1.0, z]);
+            out.push([x, 2.5, z]);
+        }
+    }
+    for (x, z) in [(0.0, -8.5), (0.0, 8.5), (8.5, 0.0), (-8.5, 0.0)] {
+        out.push([x, UPPER - 0.3, z]);
+    }
+    out
+}
